# ============================================================
# JATRA Railway Management System — Backend Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# Oracle Database 11g Connection
DB_USER=jatra
DB_PASSWORD=yourpassword
DB_DSN=localhost:1521/ORCL

# Path to Oracle Instant Client directory (required for Thick Mode / Oracle 11g)
# Windows example: C:/oracle/instantclient_19_23
# Linux example: /opt/oracle/instantclient_19_23
ORACLE_CLIENT_PATH=C:/oracle/instantclient_19_23

# JWT Secret Key (change this to a strong random value in production)
JWT_SECRET=jatra-railway-jwt-secret-change-this

# Flask settings
FLASK_DEBUG=true
FLASK_PORT=5000
