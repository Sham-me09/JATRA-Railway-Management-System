@app.route(
    "/api/manager/trains/<train_id>/delay",
    methods=["PUT"]
)
@require_role(ROLE_TRAIN_MANAGER)
def manager_update_delay(
    current_user,
    train_id
):

    data = get_json()

    delay = first_value(
        data,
        "delay",
        "delay_minutes",
        "delayMinutes",
        default=0
    )

    cause = first_value(
        data,
        "cause",
        "reason",
        default="Operational delay."
    )

    try:
        delay_value = int(delay)
    except Exception:
        return jsonify({
            "error":
                "Delay must be an integer."
        }), 400

    user_id = get_user_id(current_user)

    # Admin can create a complaint for a selected passenger.
    # Passenger submissions continue using the logged-in user's ID.
    passenger_name = first_value(
        data,
        "passengerName",
        "passenger_name",
        default=""
    )

    if passenger_name:
        name_parts = str(passenger_name).strip().split(None, 1)

        first_name = name_parts[0]
        last_name = name_parts[1] if len(name_parts) > 1 else ""

        with OracleConnection() as (lookup_conn, lookup_cursor):
            lookup_cursor.execute(
                """
                SELECT user_id
                FROM APP_USER
                WHERE UPPER(first_name) = UPPER(:first_name)
                  AND UPPER(last_name) = UPPER(:last_name)
                  AND ROWNUM = 1
                """,
                {
                    "first_name": first_name,
                    "last_name": last_name
                }
            )

            passenger_row = lookup_cursor.fetchone()

        if not passenger_row:
            return jsonify({
                "error":
                    "Selected passenger was not found."
            }), 400

        user_id = passenger_row[0]

    try:
        with OracleConnection() as (conn, cursor):

            cursor.execute(
                """
                UPDATE TRAIN_SCHEDULE
                SET
                    delay = :delay,
                    status =
                        CASE
                            WHEN :delay > 0
                            THEN 'DELAYED'
                            ELSE status
                        END

                WHERE schedule_id = (
                    SELECT schedule_id
                    FROM (
                        SELECT schedule_id
                        FROM TRAIN_SCHEDULE
                        WHERE train_id =
                              :train_id
                        ORDER BY journey_date DESC
                    )
                    WHERE ROWNUM = 1
                )
                """,
                {
                    "delay":
                        delay_value,
                    "train_id":
                        train_id,
                }
            )

            status_log_id = generate_id("LOG")

            cursor.execute(
                """
                INSERT INTO TRAIN_STATUS_LOG (
                    status_log_id,
                    train_id,
                    updated_by,
                    operational_status,
                    delay_minutes,
                    cause,
                    status_date
                )
                VALUES (
                    :status_log_id,
                    :train_id,
                    :updated_by,
                    'DELAYED',
                    :delay_minutes,
                    :cause,
                    SYSDATE
                )
                """,
                {
                    "status_log_id":
                        status_log_id,
                    "train_id":
                        train_id,
                    "updated_by":
                        user_id,
                    "delay_minutes":
                        delay_value,
                    "cause":
                        cause,
                }
            )

            cursor.execute(
                """
                SELECT DISTINCT user_id
                FROM BOOKING
                WHERE train_id =
                      :train_id

                  AND status NOT IN
                      ('CANCELLED')
                """,
                {
                    "train_id":
                        train_id
                }
            )

            passenger_ids = [
                row[0]
                for row in cursor.fetchall()
            ]

            for passenger_id in passenger_ids:

                notification_id = (
                    generate_id("NOT")
                )

                cursor.execute(
                    """
                    INSERT INTO NOTIFICATION (
                        notification_id,
                        user_id,
                        train_id,
                        title,
                        message,
                        notification_type,
                        created_at,
                        is_read
                    )
                    VALUES (
                        :notification_id,
                        :user_id,
                        :train_id,
                        :title,
                        :message,
                        'DELAY',
                        SYSTIMESTAMP,
                        'N'
                    )
                    """,
                    {
                        "notification_id":
                            notification_id,
                        "user_id":
                            passenger_id,
                        "train_id":
                            train_id,
                        "title":
                            "Train Delay",
                        "message":
                            (
                                f"Train {train_id} "
                                f"is delayed by "
                                f"{delay_value} minutes."
                            ),
                    }
                )

            conn.commit()

            return jsonify({
                "message":
                    "Train delay updated successfully.",
                "train_id":
                    train_id,
                "delay":
                    delay_value,
            }), 200

    except Exception as e:
        print(
            f"[MANAGER DELAY ERROR] {e}"
        )

        return jsonify({
            "error":
                "Failed to update train delay.",
            "details": str(e),
        }), 500


