@app.route("/api/auth/login", methods=["POST"])
def login():

    data = get_json()

    email = str(
        first_value(
            data,
            "email",
            "username",
            default=""
        )
    ).strip().lower()

    password = str(
        first_value(
            data,
            "password",
            default=""
        )
    )

    if not email or not password:
        return jsonify({
            "error": "Email and password are required."
        }), 400

    try:
        with OracleConnection() as (conn, cursor):

            cursor.execute(
                """
                SELECT
                    u.user_id,
                    u.email,
                    u.password,
                    u.user_type,
                    u.first_name,
                    u.middle_name,
                    u.last_name,
                    u.gender,
                    u.nid,
                    u.city,
                    u.house_no,
                    u.post_code,
                    u.date_of_birth,

                    (
                        SELECT MIN(up.phone_number)
                        FROM USER_PHONE_NUMBER up
                        WHERE up.user_id = u.user_id
                    ) AS phone_number,

                    (
                        SELECT MAX(e.station)
                        FROM EMPLOYEE e
                        WHERE e.user_id = u.user_id
                    ) AS station

                FROM APP_USER u

                WHERE LOWER(u.email) = :email
                """,
                {
                    "email": email
                }
            )

            row = cursor.fetchone()

            if not row:
                return jsonify({
                    "error": "Invalid email or password."
                }), 401

            columns = [
                col[0].lower()
                for col in cursor.description
            ]

            user = dict(zip(columns, row))

            stored_password = user.get("password")

            if not stored_password:
                return jsonify({
                    "error": "User password is not configured."
                }), 500

            if not check_password(
                password,
                stored_password
            ):
                return jsonify({
                    "error": "Invalid email or password."
                }), 401

            db_role = user.get("user_type")

            frontend_role = db_role_to_frontend_role(
                db_role
            )

            full_name = " ".join(
                part
                for part in [
                    user.get("first_name"),
                    user.get("middle_name"),
                    user.get("last_name")
                ]
                if part
            )

            token = generate_token(
                user["user_id"],
                db_role,
                full_name
            )

            user_data = {
                "user_id": user["user_id"],
                "email": user["email"],
                "user_type": db_role,
                "role": frontend_role,
                "first_name": user["first_name"],
                "middle_name": user["middle_name"],
                "last_name": user["last_name"],
                "gender": user["gender"],
                "nid": user["nid"],
                "city": user["city"],
                "house_no": user["house_no"],
                "post_code": user["post_code"],
                "date_of_birth": json_safe(
                    user["date_of_birth"]
                ),
                "phone_number": user["phone_number"],
                "station": user["station"],
            }

            return jsonify({
                "message": "Login successful.",
                "token": token,
                "user": user_data,
            }), 200

    except Exception as e:
        print(f"[LOGIN ERROR] {e}")

        return jsonify({
            "error": "Login failed due to a server error.",
            "details": str(e),
        }), 500


