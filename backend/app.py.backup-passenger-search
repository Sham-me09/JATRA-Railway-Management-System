    train_id = first_value(data, "trainId", "train_id")
    departure_time = first_value(data, "departureTime", "departure_time")
    arrival_time = first_value(data, "arrivalTime", "arrival_time")
    source = first_value(data, "source", "origin", default="")
    destination = first_value(data, "destination", default="")
    platform = first_value(data, "platform", default="")
    status = first_value(data, "status", default="OPERATIONAL")

    if not train_id:
        return jsonify({"error": "Train ID is required."}), 400

    if not departure_time or not arrival_time:
        return jsonify({
            "error": "Departure time and arrival time are required."
        }), 400

    if not source or not destination:
        return jsonify({
            "error": "Origin and destination are required."
        }), 400

    try:
        with OracleConnection() as (conn, cursor):

            # ----------------------------------------------------
            # Verify train
            # ----------------------------------------------------
            cursor.execute("""
                SELECT TRAIN_ID
                FROM TRAIN
                WHERE TRAIN_ID = :train_id
            """, {
                "train_id": train_id
            })

            if not cursor.fetchone():
                return jsonify({
                    "error": f"Train {train_id} does not exist."
                }), 400

            # ----------------------------------------------------
            # Find matching route
            # ----------------------------------------------------
            cursor.execute("""
                SELECT ROUTE_ID
                FROM ROUTE
                WHERE UPPER(SOURCE_STATION) =
                      UPPER(:source)
                  AND UPPER(DESTINATION) =
                      UPPER(:destination)
                
            """, {
                "source": source,
                "destination": destination
            })

            route_row = cursor.fetchone()

            if not route_row:
                # Try matching route names/station names more loosely.
                cursor.execute("""
                    SELECT ROUTE_ID
                    FROM ROUTE
                    WHERE UPPER(SOURCE_STATION) LIKE
                          '%' || UPPER(:source) || '%'
                      AND UPPER(DESTINATION) LIKE
                          '%' || UPPER(:destination) || '%'
                    
                """, {
                    "source": source,
                    "destination": destination
                })

                route_row = cursor.fetchone()

            if not route_row:
                return jsonify({
                    "error":
                        f"No route found for {source} ? {destination}."
                }), 400

            route_id = route_row[0]

            # ----------------------------------------------------
            # Find origin station
            # ----------------------------------------------------
            cursor.execute("""
                SELECT STATION_ID
                FROM STATION
                WHERE UPPER(STATION_NAME) = UPPER(:station)
                   OR UPPER(STATION_NAME) LIKE
                      '%' || UPPER(:station) || '%'
                
            """, {
                "station": source
            })

            origin_row = cursor.fetchone()

            if not origin_row:
                return jsonify({
                    "error": f"Origin station '{source}' was not found."
                }), 400

            origin_station_id = origin_row[0]

            # ----------------------------------------------------
            # Find destination station
            # ----------------------------------------------------
            cursor.execute("""
                SELECT STATION_ID
                FROM STATION
                WHERE UPPER(STATION_NAME) = UPPER(:station)
                   OR UPPER(STATION_NAME) LIKE
                      '%' || UPPER(:station) || '%'
                
            """, {
                "station": destination
            })

            destination_row = cursor.fetchone()

            if not destination_row:
                return jsonify({
                    "error":
                        f"Destination station '{destination}' was not found."
                }), 400

            destination_station_id = destination_row[0]

            # ----------------------------------------------------
            # Find platform
            # ----------------------------------------------------
            platform_id = None

            if platform:
                platform_number = str(platform).replace(
                    "Platform #", ""
                ).strip()

                cursor.execute("""
                    SELECT PLATFORM_ID
                    FROM PLATFORM
                    WHERE STATION_ID = :station_id
                      AND PLATFORM_NO = :platform_no
                    
                """, {
                    "station_id": origin_station_id,
                    "platform_no": platform_number
                })

                platform_row = cursor.fetchone()

                if platform_row:
                    platform_id = platform_row[0]

            # ----------------------------------------------------
            # Insert schedule.
            # SCHEDULE_ID intentionally omitted.
            # Oracle trigger generates it.
            # ----------------------------------------------------
            cursor.execute("""
                INSERT INTO TRAIN_SCHEDULE (
                    TRAIN_ID,
                    ROUTE_ID,
                    JOURNEY_DATE,
                    ORIGIN_STATION_ID,
                    DESTINATION_STATION_ID,
                    DEPARTURE_TIME,
                    ARRIVAL_TIME,
                    DELAY,
                    ASSIGNED_PLATFORM_ID,
                    STATUS
                )
                VALUES (
                    :train_id,
                    :route_id,
                    SYSDATE,
                    :origin_station_id,
                    :destination_station_id,
                    :departure_time,
                    :arrival_time,
                    '0 mins',
                    :platform_id,
                    :status
                )
            """, {
                "train_id": train_id,
                "route_id": route_id,
                "origin_station_id": origin_station_id,
                "destination_station_id": destination_station_id,
                "departure_time": departure_time,
                "arrival_time": arrival_time,
                "platform_id": platform_id,
                "status": str(status).upper()
            })

            conn.commit()

            return jsonify({
                "message": "Schedule created successfully."
            }), 201

    except Exception as e:
        print(f"[ADMIN SCHEDULE POST ERROR] {e}")
        return jsonify({
            "error": "Failed to create schedule.",
            "details": str(e)
        }), 500


@app.route("/api/admin/schedules", methods=["PUT"])
@require_role(ROLE_ADMIN)
def admin_update_schedule(current_user):
    data = get_json()

    schedule_id = first_value(
        data,
        "id",
        "scheduleId",
        "schedule_id"
    )

    if not schedule_id:
        return jsonify({
            "error": "Schedule ID is required."
        }), 400

    try:
        with OracleConnection() as (conn, cursor):

            # ----------------------------------------------------
            # Only update fields supplied by the existing UI.
            # ----------------------------------------------------
            train_id = first_value(data, "trainId", "train_id")
            departure_time = first_value(
                data,
                "departureTime",
                "departure_time"
            )
            arrival_time = first_value(
                data,
                "arrivalTime",
                "arrival_time"
            )
            status = first_value(
                data,
                "status",
                default=None
            )

            source = first_value(data, "source", default=None)
            destination = first_value(
                data,
                "destination",
                default=None
            )
            platform = first_value(
                data,
                "platform",
                default=None
            )

            # ----------------------------------------------------
            # Resolve route/stations/platform when names are sent.
            # ----------------------------------------------------
            route_id = None
            origin_station_id = None
            destination_station_id = None
            platform_id = None

            if source and destination:
                cursor.execute("""
                    SELECT ROUTE_ID
                    FROM ROUTE
                    WHERE UPPER(SOURCE_STATION) LIKE
                          '%' || UPPER(:source) || '%'
                      AND UPPER(DESTINATION) LIKE
                          '%' || UPPER(:destination) || '%'
                    
                """, {
                    "source": source,
                    "destination": destination
                })

                row = cursor.fetchone()

                if row:
                    route_id = row[0]

            if source:
                cursor.execute("""
                    SELECT STATION_ID
                    FROM STATION
                    WHERE UPPER(STATION_NAME) LIKE
                          '%' || UPPER(:station) || '%'
                    
                """, {
                    "station": source
                })

                row = cursor.fetchone()

                if row:
                    origin_station_id = row[0]

            if destination:
                cursor.execute("""
                    SELECT STATION_ID
                    FROM STATION
                    WHERE UPPER(STATION_NAME) LIKE
                          '%' || UPPER(:station) || '%'
                    
                """, {
                    "station": destination
                })

                row = cursor.fetchone()

                if row:
                    destination_station_id = row[0]

            if platform and origin_station_id:
                platform_number = str(platform).replace(
                    "Platform #", ""
                ).strip()

                cursor.execute("""
                    SELECT PLATFORM_ID
                    FROM PLATFORM
                    WHERE STATION_ID = :station_id
                      AND PLATFORM_NO = :platform_no
                    
                """, {
                    "station_id": origin_station_id,
                    "platform_no": platform_number
                })

                row = cursor.fetchone()

                if row:
                    platform_id = row[0]

            # ----------------------------------------------------
            # Build dynamic update safely.
            # ----------------------------------------------------
            updates = []
            params = {
                "schedule_id": schedule_id
            }

            if train_id:
                updates.append("TRAIN_ID = :train_id")
                params["train_id"] = train_id

            if route_id:
                updates.append("ROUTE_ID = :route_id")
                params["route_id"] = route_id

            if origin_station_id:
                updates.append(
                    "ORIGIN_STATION_ID = :origin_station_id"
                )
                params["origin_station_id"] = origin_station_id

            if destination_station_id:
                updates.append(
                    "DESTINATION_STATION_ID = :destination_station_id"
                )
                params["destination_station_id"] = destination_station_id

            if departure_time:
                updates.append(
                    "DEPARTURE_TIME = :departure_time"
                )
                params["departure_time"] = departure_time

            if arrival_time:
                updates.append(
                    "ARRIVAL_TIME = :arrival_time"
                )
                params["arrival_time"] = arrival_time

            if platform_id:
                updates.append(
                    "ASSIGNED_PLATFORM_ID = :platform_id"
                )
                params["platform_id"] = platform_id

            if status:
                updates.append("STATUS = :status")
                params["status"] = str(status).upper()

            if not updates:
                return jsonify({
                    "error": "No schedule fields supplied."
                }), 400

            cursor.execute(
                f"""
                UPDATE TRAIN_SCHEDULE
                SET {", ".join(updates)}
                WHERE SCHEDULE_ID = :schedule_id
                """,
                params
            )

            if cursor.rowcount == 0:
                return jsonify({
                    "error": "Schedule not found."
                }), 404

            conn.commit()

            return jsonify({
                "message": "Schedule updated successfully."
            }), 200

    except Exception as e:
        print(f"[ADMIN SCHEDULE PUT ERROR] {e}")
        return jsonify({
            "error": "Failed to update schedule.",
            "details": str(e)
        }), 500


