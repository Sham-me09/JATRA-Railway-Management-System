@require_auth
def create_complaint(current_user):

    data = get_json()

    user_id = get_user_id(current_user)

    # Admin can create a complaint for a selected passenger.
    # Passenger submissions continue using the logged-in user's ID.
    passenger_name = first_value(
        data,
        "passengerName",
        "passenger_name",
        default=""
    )

    if passenger_name:
        name_parts = str(passenger_name).strip().split(None, 1)

        first_name = name_parts[0]
        last_name = name_parts[1] if len(name_parts) > 1 else ""

        with OracleConnection() as (lookup_conn, lookup_cursor):
            lookup_cursor.execute(
                """
                SELECT user_id
                FROM APP_USER
                WHERE UPPER(first_name) = UPPER(:first_name)
                  AND UPPER(last_name) = UPPER(:last_name)
                  AND ROWNUM = 1
                """,
                {
                    "first_name": first_name,
                    "last_name": last_name
                }
            )

            passenger_row = lookup_cursor.fetchone()

        if not passenger_row:
            return jsonify({
                "error":
                    "Selected passenger was not found."
            }), 400

        user_id = passenger_row[0]

    description = first_value(
        data,
        "description",
        "complaint",
        "message",
        default=""
    )

    train_name = first_value(
        data,
        "train",
        "trainName",
        "train_name",
        "trainReference",
        default=""
    )

    category = first_value(
        data,
        "category",
        default=None
    )

    status = first_value(
        data,
        "status",
        "resolutionStatus",
        "resolution_status",
        default="PENDING"
    )

    status_map = {
        "pending": "PENDING",
        "investigating": "IN_PROGRESS",
        "in progress": "IN_PROGRESS",
        "resolved": "RESOLVED"
    }

    status = status_map.get(
        str(status).strip().lower(),
        "PENDING"
    )

    if not description:
        return jsonify({
            "error":
                "Complaint description is required."
        }), 400

    if not train_name:
        return jsonify({
            "error":
                "Train selection is required."
        }), 400

    try:
        with OracleConnection() as (conn, cursor):

            # Generate complaint ID
            cursor.execute(
                """
                SELECT 'CMP' ||
                       LPAD(
                           NVL(
                               MAX(
                                   TO_NUMBER(
                                       REGEXP_SUBSTR(
                                           complaint_id,
                                           '[0-9]+$'
                                       )
                                   )
                               ),
                               0
                           ) + 1,
                           3,
                           '0'
                       )
                FROM COMPLAINT
                WHERE REGEXP_LIKE(
                    complaint_id,
                    '^CMP[0-9]+$'
                )
                """
            )

            complaint_id = cursor.fetchone()[0]

            # Save train name and category directly
            cursor.execute(
                """
                INSERT INTO COMPLAINT (
                    complaint_id,
                    user_id,
                    admin_id,
                    category,
                    train_name,
                    train_id,
                    status,
                    description,
                    complaint_date,
                    resolution_comment
                )
                VALUES (
                    :complaint_id,
                    :user_id,
                    NULL,
                    :category,
                    :train_name,
                    NULL,
                    :status,
                    :description,
                    SYSDATE,
                    NULL
                )
                """,
                {
                    "complaint_id":
                        complaint_id,
                    "user_id":
                        user_id,
                    "category":
                        category,
                    "train_name":
                        train_name,
                    "status":
                        status,
                    "description":
                        description
                }
            )

            conn.commit()

            return jsonify({
                "message":
                    "Complaint submitted successfully.",
                "complaint_id":
                    complaint_id,
                "train_name":
                    train_name,
                "category":
                    category
            }), 201

    except Exception as e:
        print(
            f"[COMPLAINT POST ERROR] {e}"
        )

        return jsonify({
            "error":
                "Failed to submit complaint.",
            "details": str(e),
        }), 500

