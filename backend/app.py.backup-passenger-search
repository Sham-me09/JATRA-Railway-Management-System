def generate_id(prefix):
    return f"{prefix}-{uuid.uuid4().hex[:16].upper()}"


def rows_to_dicts(cursor):
    columns = [col[0].lower() for col in cursor.description]
    return [
        dict(zip(columns, row))
        for row in cursor.fetchall()
    ]


def row_to_dict(cursor, row):
    if row is None:
        return None

    columns = [
        col[0].lower()
        for col in cursor.description
    ]

    return dict(zip(columns, row))


def json_safe(value):
    if isinstance(value, (datetime, date)):
        return value.isoformat()

    if isinstance(value, bytes):
        return value.decode(
            "utf-8",
            errors="ignore"
        )

    return value


def clean_dict(data):
    if isinstance(data, dict):
        return {
            key: clean_dict(value)
            for key, value in data.items()
        }

    if isinstance(data, list):
        return [
            clean_dict(value)
            for value in data
        ]

    return json_safe(data)


def get_json():
    return request.get_json(silent=True) or {}


def first_value(data, *keys, default=None):
    for key in keys:
        if key in data and data[key] is not None:
            return data[key]

    return default


def get_current_user_safe():
    try:
        return get_current_user()
    except Exception:
        return None


def get_user_id(current_user):
    if not current_user:
        return None

    return (
        current_user.get("user_id")
        or current_user.get("userId")
        or current_user.get("id")
    )


def get_user_role(current_user):
    if not current_user:
        return None

    return (
        current_user.get("role")
        or current_user.get("user_type")
        or current_user.get("userType")
    )
def role_required(required_role):
    def decorator(f):
        @wraps(f)
        def wrapper(*args, **kwargs):
            current_user = get_current_user_safe()

            if not current_user:
                return jsonify({
                    "error": "Authentication required"
                }), 401

            user_role = get_user_role(current_user)

            if user_role != required_role:
                return jsonify({
                    "error": "Access denied",
                    "required_role": required_role,
                    "your_role": user_role
                }), 403

            return f(*args, **kwargs)

        return wrapper
    return decorator

def db_role_to_frontend_role(db_role):
    if not db_role:
        return None

    return DB_TO_FRONTEND_ROLE.get(
        db_role,
        str(db_role).lower()
    )


