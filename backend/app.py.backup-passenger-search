@app.route("/api/employees", methods=["GET"])
def get_employees():
    try:
        with OracleConnection() as (conn, cursor):
            cursor.execute("""
                SELECT
                    e.USER_ID,
                    u.FIRST_NAME || ' ' || u.LAST_NAME,
                    e.ROLE,
                    e.STATION,
                    (SELECT p.PHONE_NUMBER
                     FROM USER_PHONE_NUMBER p
                     WHERE p.USER_ID = e.USER_ID
                     AND ROWNUM = 1),
                    (SELECT ec.NAME
                     FROM EMERGENCY_CONTACT ec
                     WHERE ec.EMPLOYEE_ID = e.USER_ID
                     AND ROWNUM = 1),
                    (SELECT ec.RELATIONSHIP
                     FROM EMERGENCY_CONTACT ec
                     WHERE ec.EMPLOYEE_ID = e.USER_ID
                     AND ROWNUM = 1),
                    (SELECT ec.PHONE_NUMBER
                     FROM EMERGENCY_CONTACT ec
                     WHERE ec.EMPLOYEE_ID = e.USER_ID
                     AND ROWNUM = 1),
                    e.STATUS
                FROM EMPLOYEE e
                JOIN APP_USER u
                  ON u.USER_ID = e.USER_ID
                ORDER BY e.USER_ID
            """)

            employees = []

            for r in cursor.fetchall():
                employees.append({
                    "user_id": r[0],
                    "name": r[1],
                    "role": r[2],
                    "station": r[3],
                    "phone": r[4],
                    "emergency_contact_name": r[5],
                    "emergency_contact_relation": r[6],
                    "emergency_contact_phone": r[7],
                    "status": r[8]
                })

            return jsonify({"employees": employees})

    except Exception as e:
        return jsonify({"error": str(e)}), 500


@app.route("/api/admin/employees", methods=["POST"])
def add_employee():
    data = get_json()

    user_id = str(first_value(data, "user_id", "id", default="")).strip()
    name = str(first_value(data, "name", default="")).strip()
    role = str(first_value(data, "role", "designation", default="")).strip()
    station = first_value(data, "station", default=None)
    phone = first_value(data, "phone", default=None)
    status = str(first_value(data, "status", default="ACTIVE")).strip().upper()

    ec_name = first_value(data, "emergencyContactName", default=None)
    ec_relation = first_value(data, "emergencyContactRelation", default=None)
    ec_phone = first_value(data, "emergencyContactPhone", default=None)

    if not user_id:
        return jsonify({"error": "Employee ID is required."}), 400

    if not name or not role:
        return jsonify({
            "error": "Employee name and designation are required."
        }), 400

    parts = name.split(None, 1)
    first_name = parts[0]
    last_name = parts[1] if len(parts) > 1 else parts[0]

    role_map = {
        "STATION MASTER": "STATION_MASTER",
        "TICKET MANAGER": "TICKET_MANAGER",
        "TRAIN MANAGER": "TRAIN_MANAGER",
        "LOCOMOTIVE PILOT": "LOCOMOTIVE_PILOT",
        "TICKET EXAMINER (TTE)": "TICKET_EXAMINER"
    }

    db_role = role_map.get(
        role.upper(),
        role.upper().replace(" ", "_")
    )

    db_status = "ON_LEAVE" if status == "ON LEAVE" else "ACTIVE"

    if db_role in (
        "TRAIN_MANAGER",
        "STATION_MASTER",
        "TICKET_MANAGER"
    ):
        user_type = db_role
    else:
        user_type = "EMPLOYEE"

    try:
        with OracleConnection() as (conn, cursor):

            cursor.execute(
                "SELECT USER_ID FROM APP_USER WHERE USER_ID = :id",
                {"id": user_id}
            )

            if cursor.fetchone():
                return jsonify({
                    "error": "User ID already exists."
                }), 409

            cursor.execute("""
                INSERT INTO APP_USER (
                    USER_ID, EMAIL, PASSWORD, USER_TYPE,
                    FIRST_NAME, MIDDLE_NAME, LAST_NAME,
                    GENDER, NID, CITY, HOUSE_NO,
                    POST_CODE, DATE_OF_BIRTH
                )
                VALUES (
                    :user_id,
                    :email,
                    :password,
                    :user_type,
                    :first_name,
                    NULL,
                    :last_name,
                    'OTHER',
                    :nid,
                    :city,
                    NULL,
                    NULL,
                    TO_DATE(:dob, 'YYYY-MM-DD')
                )
            """, {
                "user_id": user_id,
                "email": user_id.lower() + "@railway.local",
                "password": "123456",
                "user_type": user_type,
                "first_name": first_name,
                "last_name": last_name,
                "nid": "NID-" + user_id,
                "city": station,
                "dob": "2000-01-01"
            })

            cursor.execute("""
                INSERT INTO EMPLOYEE (
                    USER_ID,
                    SALARY,
                    JOINING_DATE,
                    ROLE,
                    STATION,
                    STATUS
                )
                VALUES (
                    :user_id,
                    0,
                    SYSDATE,
                    :role,
                    :station,
                    :status
                )
            """, {
                "user_id": user_id,
                "role": db_role,
                "station": station,
                "status": db_status
            })

            if phone:
                cursor.execute("""
                    INSERT INTO USER_PHONE_NUMBER (
                        USER_ID,
                        PHONE_NUMBER
                    )
                    VALUES (
                        :user_id,
                        :phone
                    )
                """, {
                    "user_id": user_id,
                    "phone": str(phone)
                })

            if ec_name and ec_relation and ec_phone:
                cursor.execute("""
                    INSERT INTO EMERGENCY_CONTACT (
                        EMERGENCY_ID,
                        EMPLOYEE_ID,
                        NAME,
                        RELATIONSHIP,
                        PHONE_NUMBER
                    )
                    VALUES (
                        'EC' || TO_CHAR(SYSDATE, 'YYMMDDHH24MISS'),
                        :user_id,
                        :name,
                        :relation,
                        :phone
                    )
                """, {
                    "user_id": user_id,
                    "name": ec_name,
                    "relation": ec_relation,
                    "phone": str(ec_phone)
                })

            conn.commit()

            return jsonify({
                "message": "Employee created successfully.",
                "id": user_id
            }), 201

    except Exception as e:
        return jsonify({"error": str(e)}), 500


