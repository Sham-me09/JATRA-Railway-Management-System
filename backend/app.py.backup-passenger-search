@app.route(
    "/api/admin/schedule-requests/<request_id>/approve",
    methods=["PUT"]
)
@require_role(ROLE_ADMIN)
def approve_schedule_request(current_user, request_id):

    data = get_json()
    review_comment = first_value(
        data,
        "review_comment",
        "reviewComment",
        default="Approved by Admin"
    )

    try:
        with OracleConnection() as (conn, cursor):

            cursor.execute("""
                SELECT
                    REQUEST_ID,
                    TRAIN_ID,
                    SCHEDULE_ID,
                    REQUESTED_CHANGE,
                    STATUS
                FROM SCHEDULE_UPDATE_REQUEST
                WHERE REQUEST_ID = :request_id
                FOR UPDATE
            """, {
                "request_id": request_id
            })

            request_row = cursor.fetchone()

            if not request_row:
                return jsonify({
                    "error": "Schedule update request not found."
                }), 404

            _, train_id, schedule_id, requested_change, status = request_row

            if str(status).upper() != "PENDING":
                return jsonify({
                    "error":
                        f"Request is already {status}."
                }), 400

            # ------------------------------------------------
            # For the existing free-text request format,
            # apply supported changes that contain times/platform.
            # ------------------------------------------------
            update_parts = []
            params = {
                "schedule_id": schedule_id
            }

            text_change = str(
                requested_change or ""
            )

            import re

            # Example:
            # "Change departure time to 07:30 AM"
            departure_match = re.search(
                r"departure(?: time)?\s*(?:to|at)\s*"
                r"(\d{1,2}:\d{2}\s*(?:AM|PM)?)",
                text_change,
                re.IGNORECASE
            )

            if departure_match:
                update_parts.append(
                    "DEPARTURE_TIME = :departure_time"
                )
                params["departure_time"] = (
                    departure_match.group(1).strip()
                )

            # Example:
            # "Change arrival time to 08:30 PM"
            arrival_match = re.search(
                r"arrival(?: time)?\s*(?:to|at)\s*"
                r"(\d{1,2}:\d{2}\s*(?:AM|PM)?)",
                text_change,
                re.IGNORECASE
            )

            if arrival_match:
                update_parts.append(
                    "ARRIVAL_TIME = :arrival_time"
                )
                params["arrival_time"] = (
                    arrival_match.group(1).strip()
                )

            # Example:
            # "assign Platform #2"
            platform_match = re.search(
                r"platform\s*#?\s*(\d+)",
                text_change,
                re.IGNORECASE
            )

            if platform_match and schedule_id:
                platform_number = platform_match.group(1)

                cursor.execute("""
                    SELECT ORIGIN_STATION_ID
                    FROM TRAIN_SCHEDULE
                    WHERE SCHEDULE_ID = :schedule_id
                """, {
                    "schedule_id": schedule_id
                })

                station_row = cursor.fetchone()

                if station_row:
                    cursor.execute("""
                        SELECT PLATFORM_ID
                        FROM PLATFORM
                        WHERE STATION_ID = :station_id
                          AND PLATFORM_NO = :platform_no
                        
                    """, {
                        "station_id": station_row[0],
                        "platform_no": platform_number
                    })

                    platform_row = cursor.fetchone()

                    if platform_row:
                        update_parts.append(
                            "ASSIGNED_PLATFORM_ID = :platform_id"
                        )
                        params["platform_id"] = platform_row[0]

            # ------------------------------------------------
            # Update actual schedule if supported changes exist.
            # ------------------------------------------------
            if update_parts and schedule_id:
                cursor.execute(
                    f"""
                    UPDATE TRAIN_SCHEDULE
                    SET {", ".join(update_parts)}
                    WHERE SCHEDULE_ID = :schedule_id
                    """,
                    params
                )

            # ------------------------------------------------
            # Mark request approved.
            # ------------------------------------------------
            cursor.execute("""
                UPDATE SCHEDULE_UPDATE_REQUEST
                SET
                    STATUS = 'APPROVED',
                    REVIEWED_BY = :reviewed_by,
                    REVIEW_DATE = SYSDATE,
                    REVIEW_COMMENT = :review_comment
                WHERE REQUEST_ID = :request_id
            """, {
                "reviewed_by": get_user_id(current_user),
                "review_comment": review_comment,
                "request_id": request_id
            })

            conn.commit()

            return jsonify({
                "message":
                    "Schedule update request approved successfully.",
                "request_id": request_id,
                "schedule_updated":
                    bool(update_parts and schedule_id)
            }), 200

    except Exception as e:
        print(
            f"[SCHEDULE APPROVE ERROR] {e}"
        )

        return jsonify({
            "error":
                "Failed to approve schedule request.",
            "details": str(e)
        }), 500


@app.route(
    "/api/admin/schedule-requests/<request_id>/reject",
    methods=["PUT"]
)
@require_role(ROLE_ADMIN)
def reject_schedule_request(current_user, request_id):

    data = get_json()

    review_comment = first_value(
        data,
        "review_comment",
        "reviewComment",
        default="Rejected by Admin"
    )

    try:
        with OracleConnection() as (conn, cursor):

            cursor.execute("""
                SELECT STATUS
                FROM SCHEDULE_UPDATE_REQUEST
                WHERE REQUEST_ID = :request_id
                FOR UPDATE
            """, {
                "request_id": request_id
            })

            row = cursor.fetchone()

            if not row:
                return jsonify({
                    "error":
                        "Schedule update request not found."
                }), 404

            if str(row[0]).upper() != "PENDING":
                return jsonify({
                    "error":
                        f"Request is already {row[0]}."
                }), 400

            cursor.execute("""
                UPDATE SCHEDULE_UPDATE_REQUEST
                SET
                    STATUS = 'REJECTED',
                    REVIEWED_BY = :reviewed_by,
                    REVIEW_DATE = SYSDATE,
                    REVIEW_COMMENT = :review_comment
                WHERE REQUEST_ID = :request_id
            """, {
                "reviewed_by": get_user_id(current_user),
                "review_comment": review_comment,
                "request_id": request_id
            })

            conn.commit()

            return jsonify({
                "message":
                    "Schedule update request rejected.",
                "request_id": request_id
            }), 200

    except Exception as e:
        print(
            f"[SCHEDULE REJECT ERROR] {e}"
        )

        return jsonify({
            "error":
                "Failed to reject schedule request.",
            "details": str(e)
        }), 500





