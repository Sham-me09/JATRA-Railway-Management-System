@app.route("/api/admin/lost-items", methods=["POST"])
@require_role(ROLE_ADMIN, ROLE_STATION_MASTER)
def admin_create_lost_item(current_user):
    try:
        data = get_json()

        item_name = first_value(
            data,
            "itemName",
            "item",
            default=""
        )

        if not item_name:
            return jsonify({
                "error": "Item name is required."
            }), 400

        user_id = get_user_id(current_user)

        user_role = str(get_user_role(current_user) or "").upper()

        # Existing form field:
        # "Train / Coach / Station"
        combined_value = first_value(
            data,
            "train",
            "trainId",
            "location",
            default=""
        )

        date_value = first_value(
            data,
            "date",
            "foundDate",
            default=None
        )

        description = first_value(
            data,
            "description",
            "desc",
            default=None
        )

        status = first_value(
            data,
            "status",
            default="UNCLAIMED"
        )

        lost_id = None

        with OracleConnection() as (conn, cursor):

            # ----------------------------------------------------
            # Determine station ownership
            # ----------------------------------------------------
            if user_role == ROLE_STATION_MASTER:

                station_master_id = user_id

            else:
                # ------------------------------------------------
                # ADMIN: determine Station Master from the
                # existing Train / Coach / Station field.
                # ------------------------------------------------
                station_master_id = first_value(
                    data,
                    "stationMasterId",
                    "station_master_id",
                    "stationMaster",
                    default=None
                )

                if not station_master_id and combined_value:
                    station_text = str(combined_value).strip()

                    # First try to match the complete value.
                    cursor.execute("""
                        SELECT SM.USER_ID
                        FROM STATION_MASTER SM
                        JOIN EMPLOYEE E
                          ON E.USER_ID = SM.USER_ID
                        WHERE UPPER(E.STATION) = UPPER(:station_text)
                           OR UPPER(E.STATION) LIKE
                              '%' || UPPER(:station_text) || '%'
                    """, {
                        "station_text": station_text
                    })

                    station_row = cursor.fetchone()

                    if station_row:
                        station_master_id = station_row[0]

                    # If the field contains train/coach/station information,
                    # search each slash-separated part for a station.
                    if not station_master_id:
                        parts = [
                            p.strip()
                            for p in station_text.replace("|", "/").split("/")
                            if p.strip()
                        ]

                        for part in parts:
                            cursor.execute("""
                                SELECT SM.USER_ID
                                FROM STATION_MASTER SM
                                JOIN EMPLOYEE E
                                  ON E.USER_ID = SM.USER_ID
                                WHERE UPPER(E.STATION) = UPPER(:station_text)
                                   OR UPPER(E.STATION) LIKE
                                      '%' || UPPER(:station_text) || '%'
                            """, {
                                "station_text": part
                            })

                            station_row = cursor.fetchone()

                            if station_row:
                                station_master_id = station_row[0]
                                break

                if not station_master_id:
                    return jsonify({
                        "error":
                            "Could not determine the station from the existing Train / Coach / Station field."
                    }), 400
            # ----------------------------------------------------
            # Validate Station Master
            # ----------------------------------------------------
            cursor.execute("""
                SELECT SM.USER_ID
                FROM STATION_MASTER SM
                JOIN APP_USER U
                  ON U.USER_ID = SM.USER_ID
                JOIN EMPLOYEE E
                  ON E.USER_ID = SM.USER_ID
                WHERE SM.USER_ID = :station_master_id
                  AND UPPER(U.USER_TYPE) = 'STATION_MASTER'
            """, {
                "station_master_id": station_master_id
            })

            station_row = cursor.fetchone()

            if not station_row:
                return jsonify({
                    "error": "Invalid Station Master."
                }), 400

            # ----------------------------------------------------
            # Resolve train
            # ----------------------------------------------------
            train_id = None

            if combined_value:

                cursor.execute("""
                    SELECT TRAIN_ID
                    FROM TRAIN
                    WHERE TRAIN_ID = :train_value
                       OR UPPER(TRAIN_NAME) =
                          UPPER(:train_value)
                """, {
                    "train_value": str(combined_value).strip()
                })

                train_row = cursor.fetchone()

                if train_row:
                    train_id = train_row[0]

            # ----------------------------------------------------
            # Date
            # ----------------------------------------------------
            if date_value:

                try:
                    cursor.execute("""
                        INSERT INTO LOST_ITEM (
                            LOST_ID,
                            STATION_MASTER_ID,
                            ITEM_NAME,
                            TRAIN_ID,
                            COACH_NO,
                            SEAT_NUMBER,
                            LOCATION_DETAIL,
                            STATUS,
                            FOUND_DATE,
                            DESCRIPTION
                        )
                        VALUES (
                            :lost_id,
                            :station_master_id,
                            :item_name,
                            :train_id,
                            NULL,
                            NULL,
                            :location_detail,
                            :status,
                            TO_DATE(:found_date, 'YYYY-MM-DD'),
                            :description
                        )
                    """, {
                        "lost_id": lost_id,
                        "station_master_id": station_master_id,
                        "item_name": item_name,
                        "train_id": train_id,
                        "location_detail": combined_value,
                        "status": status,
                        "found_date": str(date_value),
                        "description": description
                    })

                except Exception:
                    raise

            else:

                cursor.execute("""
                    INSERT INTO LOST_ITEM (
                        LOST_ID,
                        STATION_MASTER_ID,
                        ITEM_NAME,
                        TRAIN_ID,
                        COACH_NO,
                        SEAT_NUMBER,
                        LOCATION_DETAIL,
                        STATUS,
                        FOUND_DATE,
                        DESCRIPTION
                    )
                    VALUES (
                        :lost_id,
                        :station_master_id,
                        :item_name,
                        :train_id,
                        NULL,
                        NULL,
                        :location_detail,
                        :status,
                        SYSDATE,
                        :description
                    )
                """, {
                    "lost_id": lost_id,
                    "station_master_id": station_master_id,
                    "item_name": item_name,
                    "train_id": train_id,
                    "location_detail": combined_value,
                    "status": status,
                    "description": description
                })

            conn.commit()

        return jsonify({
            "message": "Lost item created successfully.",
            "lostId": lost_id
        }), 201

    except Exception as e:
        print(f"[ADMIN LOST ITEM CREATE ERROR] {e}")

        return jsonify({
            "error": str(e)
        }), 500


