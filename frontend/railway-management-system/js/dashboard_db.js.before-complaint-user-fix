        "manage-maintenance.html": "maintenance",

        "manage-employees.html":
            "employees",

        "manage-tickets.html":
            "tickets",

        "manage-cancellations.html":
            "cancellations",

        "manage-lost-items.html":
            "lostItems"
    };

    var key =
        storageMap[pagePath];

    if (key) {

        localStorage.setItem(
            key,
            JSON.stringify(rows)
        );
    }

    console.log(
        "Loaded " +
        rows.length +
        " records from Oracle for " +
        pagePath
    );

    return rows;
}


