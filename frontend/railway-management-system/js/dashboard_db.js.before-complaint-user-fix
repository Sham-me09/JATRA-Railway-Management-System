async function databaseGet(pagePath) {

    var config = DATABASE_CONFIG[pagePath];

    if (!config || !config.get) {
        throw new Error(
            "No GET API configured for " + pagePath
        );
    }

    var result = await apiRequest(config.get);

    var rows = [];

    if (Array.isArray(result)) {
        rows = result;
    }

    else if (Array.isArray(result.data)) {
        rows = result.data;
    }
    else if (Array.isArray(result.tickets)) {
        rows = result.tickets;
    }

    else if (Array.isArray(result.cancellations)) {
        rows = result.cancellations;
    }

    else if (Array.isArray(result.lostItems)) {
        rows = result.lostItems;
    }

    else if (Array.isArray(result.trains)) {
        rows = result.trains;
    }

    else if (Array.isArray(result.coaches)) {
        rows = result.coaches;
    }

    else if (Array.isArray(result.seats)) {
        rows = result.seats;
    }

    else if (Array.isArray(result.stations)) {
        rows = result.stations;
    }

    else if (Array.isArray(result.platforms)) {
        rows = result.platforms;
    }

    else if (Array.isArray(result.routes)) {
        rows = result.routes;
    }

    else if (Array.isArray(result.schedules)) {
        rows = result.schedules;
    }

    else if (Array.isArray(result.fares)) {
        rows = result.fares;
    }

    else if (Array.isArray(result.maintenance)) {
        rows = result.maintenance;
    }

    else if (Array.isArray(result.employees)) {
        rows = result.employees;
    }

    else if (Array.isArray(result.complaints)) {
        rows = result.complaints;
    }

    var normalizedRows = rows.map(function(row) {

        return normalizeDatabaseData(
            pagePath,
            row
        );

    });

    if (
        pagePath === "manage-lost-items.html" &&
        typeof window.updateLostItemStationScope === "function"
    ) {
        window.updateLostItemStationScope(normalizedRows);
    }

    return normalizedRows;
}


/* =========================
   ADD
   ========================= */

async function databaseAdd(pagePath, data) {

    var config = DATABASE_CONFIG[pagePath];

    /* Special ADD handling for cancellation */
    if (pagePath === "manage-cancellations.html") {
        if (!data.ticketId) {
            throw new Error("Ticket ID is required.");
        }

        return await apiRequest(
            "/api/tickets/" + encodeURIComponent(data.ticketId) + "/cancel",
            {
                method: "POST",
                body: JSON.stringify({
                    reason: data.reason || ""
                })
            }
        );
    }

    /* Special ADD handling for complaints */
    if (pagePath === "manage-complaints.html") {
        var complaintDescription =
            data.description ||
            data.desc ||
            data.complaintDescription ||
            data.complaint ||
            data.message ||
            data.details ||
            "";

        var complaintTrain =
            data.train ||
            data.trainReference ||
            data.train_reference ||
            data.trainName ||
            "";

        var complaintPassenger =
            data.passengerName ||
            data.passenger_name ||
            data.name ||
            "";

        var complaintStatus =
            data.status ||
            data.resolutionStatus ||
            data.resolution_status ||
            "PENDING";

        return await apiRequest(
            "/api/complaints",
            {
                method: "POST",
                body: JSON.stringify({
                    description: complaintDescription,
                    train: complaintTrain,
                    passengerName: complaintPassenger,
                    status: complaintStatus
                })
            }
        );
    }
    if (!config || !config.add) {
        throw new Error(
            "No ADD API configured for " + pagePath
        );
    }

    var databaseData =
        await prepareDatabaseData(
            pagePath,
            data,
            data.id
        );

    console.log(
        "DATABASE ADD:",
        databaseData
    );

    return await apiRequest(
        config.add,
        {
            method: "POST",
            body: JSON.stringify(databaseData)
        }
    );
}


