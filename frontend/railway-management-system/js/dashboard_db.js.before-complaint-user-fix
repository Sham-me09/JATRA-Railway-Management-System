/* =========================
   PLATFORM
   ========================= */

async function convertPlatformData(data, id) {

    var stationId = data.stationId || data.station_id;

    if (!stationId && data.station) {

        var stationResult = await apiRequest("/api/stations");

        var stations = stationResult.stations || stationResult.data || stationResult;

        if (!Array.isArray(stations)) {
            throw new Error("Could not load station list.");
        }

        var station = stations.find(function(s) {
            return String(
                s.station_name || s.name || ""
            ).trim().toLowerCase() ===
            String(data.station).trim().toLowerCase();
        });

        if (!station) {
            throw new Error(
                "Station not found: " + data.station
            );
        }

        stationId =
            station.station_id ||
            station.id;
    }

    if (!stationId) {
        throw new Error("Station ID could not be determined.");
    }

    return {
        station_id: stationId,
        platform_no:
            data.platformNumber ||
            data.platformNo ||
            data.platform_no,
        gauge_type:
            data.type ||
            data.gaugeType ||
            data.gauge_type,
        status: data.status || "AVAILABLE"
    };
}

