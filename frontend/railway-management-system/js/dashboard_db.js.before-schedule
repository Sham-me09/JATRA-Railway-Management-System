                trainId: row.train_id,
                name: row.coach_name,
                type: row.coach_type,
                capacity: row.capacity,
                status: row.status
            };


        case "manage-seats.html":

            return {
                id: row.seat_id,
                coachId: row.coach_id,
                seatNumber: row.seat_number,
                status: row.seat_status
