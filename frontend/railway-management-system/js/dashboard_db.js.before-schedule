/* =========================
   PREPARE DATA
   ========================= */

function prepareDatabaseData(pagePath, data, id) {

    switch (pagePath) {

        case "manage-trains.html":
            return convertTrainData(data, id);

        case "manage-coaches.html":
            return convertCoachData(data, id);

        case "manage-seats.html":
            return convertSeatData(data, id);

        case "manage-stations.html":
            return convertStationData(data, id);

        case "manage-platforms.html":
            return convertPlatformData(data, id);

        case "manage-routes.html":
            return convertRouteData(data, id);

        case "manage-fares.html":
            return convertFareData(data, id);

        case "manage-maintenance.html":
            return convertMaintenanceData(data, id);

        default:
            return data;
    }
}


/* =========================
   NORMALIZE DATA
   ========================= */

function normalizeDatabaseData(pagePath, row) {

    switch (pagePath) {

        case "manage-trains.html":

            return {
                id: row.train_id,
                name: row.train_name,
                type: row.train_category,
                travelDuration: row.travel_duration,
                offDay: row.off_day,
                status: row.operational_status
