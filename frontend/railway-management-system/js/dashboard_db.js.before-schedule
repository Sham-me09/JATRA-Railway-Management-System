            return {
                id: row.platform_id,
                stationId: row.station_id,
                platformNo: row.platform_no,
                gaugeType: row.gauge_type,
                status: row.status
            };


        case "manage-routes.html":

            return {
                id: row.route_id,
                name: row.route_name,
                source: row.source_station,
