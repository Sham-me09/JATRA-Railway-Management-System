/* =========================
   REFRESH PAGE
   ========================= */

async function refreshDatabasePage(pagePath) {

    var rows =
        await databaseGet(pagePath);

    var storageMap = {

        "manage-trains.html":
            "trains",

        "manage-coaches.html":
            "coaches",

        "manage-seats.html":
            "seats",

        "manage-stations.html":
            "stations",

        "manage-platforms.html":
            "platforms",

        "manage-routes.html":
            "routes",

        "manage-fares.html":
            "fares",

        "manage-maintenance.html":
            "maintenance"
    };

    var key =
        storageMap[pagePath];

    if (key) {

        localStorage.setItem(
            key,
            JSON.stringify(rows)
        );
    }

    console.log(
        "Loaded " +
        rows.length +
        " records from Oracle for " +
        pagePath
    );

    return rows;
}


/* =========================
   INITIALIZE CRUD PAGE
   ========================= */

async function initDatabaseCrudPage(pagePath) {

    console.log(
        "Loading " +
        pagePath +
        " from Oracle..."
    );

    try {

        await refreshDatabasePage(
            pagePath
        );

        if (
            typeof initAdminCrudTable ===
            "function"
        ) {

            initAdminCrudTable(
                pagePath
            );
        }

    } catch (error) {

        console.error(
            "DATABASE PAGE INITIALIZATION ERROR:",
            error
        );

        if (
            typeof initAdminCrudTable ===
            "function"
        ) {

            initAdminCrudTable(
                pagePath
            );
        }
    }
}


