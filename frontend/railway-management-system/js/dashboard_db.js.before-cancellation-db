/* =========================
   PLATFORM
   ========================= */

async function convertPlatformData(data, id) {

    var stationId = data.stationId;

    // Add form sends station name instead of station ID
    if (!stationId && data.station) {

        var stationResult = await apiRequest("/api/stations");

        var stations = stationResult.stations || [];

        var station = stations.find(function(s) {
            return String(s.station_name).trim().toLowerCase() ===
                   String(data.station).trim().toLowerCase();
        });

        if (!station) {
            throw new Error(
                "Station not found: " + data.station
            );
        }

        stationId = station.station_id;
    }

    return {
        platform_id: id || data.id,
        station_id: stationId,
        platform_no: data.platformNo || data.platformNumber,
        gauge_type: data.gaugeType || data.type,
        status: data.status
    };
}


