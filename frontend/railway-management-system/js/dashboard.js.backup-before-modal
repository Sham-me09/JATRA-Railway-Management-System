    staffTrainRow.classList.remove('hidden');
    if (staffTrainEl) {
      staffTrainEl.textContent = currentUser.assignedTrainName || 'Sonar Bangla Express (TR-701)';
    }
  }

  if (staffDutyRow && (currentUser.designation || currentUser.role !== 'user')) {
    staffDutyRow.classList.remove('hidden');
    if (staffDesigEl) staffDesigEl.textContent = currentUser.designation || roleDisplay;
  }

  // Emergency Contact Handling (All roles except Passenger)
  const isStaffRole = (currentUser.role !== 'user' && currentUser.role !== 'passenger');
