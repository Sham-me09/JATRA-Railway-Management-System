  const emgSummaryName = document.getElementById('profSummaryEmgName');
  const emgSummaryRelation = document.getElementById('profSummaryEmgRelation');
  const emgSummaryPhone = document.getElementById('profSummaryEmgPhone');

  if (emgSummaryBox) {
    if (isStaffRole) {
      emgSummaryBox.classList.remove('hidden');
      if (emgSummaryName) emgSummaryName.textContent = currentUser.emergencyContactName || 'Not Set';
      if (emgSummaryRelation) emgSummaryRelation.textContent = currentUser.emergencyContactRelation || 'Not Set';
      if (emgSummaryPhone) emgSummaryPhone.textContent = currentUser.emergencyContactPhone || 'Not Set';
    } else {
      emgSummaryBox.classList.add('hidden');
    }
  }

  // Populate Form Inputs
  const inputName = document.getElementById('profInputName');
  const inputEmail = document.getElementById('profInputEmail');
  const inputPhone = document.getElementById('profInputPhone');
  const inputNid = document.getElementById('profInputNid');
  const inputDob = document.getElementById('profInputDob');
  const inputGender = document.getElementById('profInputGender');
  const inputAddress = document.getElementById('profInputAddress');

  const emgSection = document.getElementById('profEmergencyContactSection');
  const inputEmgName = document.getElementById('profInputEmgName');
  const inputEmgRelation = document.getElementById('profInputEmgRelation');
  const inputEmgPhone = document.getElementById('profInputEmgPhone');

  if (emgSection) {
    if (isStaffRole) {
      emgSection.classList.remove('hidden');
      if (inputEmgName) inputEmgName.value = currentUser.emergencyContactName || '';
      if (inputEmgRelation) inputEmgRelation.value = currentUser.emergencyContactRelation || 'Spouse';
      if (inputEmgPhone) inputEmgPhone.value = currentUser.emergencyContactPhone || '';
    } else {
      emgSection.classList.add('hidden');
    }
  }

  if (inputName) inputName.value = currentUser.name || '';
  if (inputEmail) inputEmail.value = currentUser.email || '';
  if (inputPhone) inputPhone.value = currentUser.phone || '';
  if (inputNid) inputNid.value = currentUser.nid || '';
  if (inputDob) inputDob.value = currentUser.dob || '';
  if (inputGender) inputGender.value = currentUser.gender || 'Male';
  if (inputAddress) inputAddress.value = currentUser.address || '';

  // Profile Info Form Submit Handler
  const infoForm = document.getElementById('profileInfoForm');
  if (infoForm && !infoForm.dataset.bound) {
    infoForm.dataset.bound = 'true';
    infoForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const updatedName = inputName.value.trim();
      const updatedPhone = inputPhone.value.trim();
      const updatedNid = inputNid.value.trim();
      const updatedDob = inputDob.value;
      const updatedGender = inputGender.value;
      const updatedAddress = inputAddress.value.trim();

      if (!updatedName || !updatedPhone) {
        showToast('Please provide your name and phone number.', 'danger');
        return;
      }

      currentUser.name = updatedName;
      currentUser.phone = updatedPhone;
      currentUser.nid = updatedNid;
      currentUser.dob = updatedDob;
      currentUser.gender = updatedGender;
      currentUser.address = updatedAddress;

      if (isStaffRole) {
        const updatedEmgName = inputEmgName ? inputEmgName.value.trim() : '';
        const updatedEmgRelation = inputEmgRelation ? inputEmgRelation.value : '';
        const updatedEmgPhone = inputEmgPhone ? inputEmgPhone.value.trim() : '';
        currentUser.emergencyContactName = updatedEmgName;
        currentUser.emergencyContactRelation = updatedEmgRelation;
        currentUser.emergencyContactPhone = updatedEmgPhone;
      }

      setCurrentUser(currentUser);

      const users = JSON.parse(localStorage.getItem('users') || '[]');
      const userIdx = users.findIndex(u => u.id === currentUser.id || u.email === currentUser.email);
      if (userIdx !== -1) {
        users[userIdx] = { ...users[userIdx], ...currentUser };
        localStorage.setItem('users', JSON.stringify(users));
      }

      // Also sync employee directory if matched
      if (isStaffRole) {
        const employees = JSON.parse(localStorage.getItem('employees') || '[]');
        let empChanged = false;
        employees.forEach(emp => {
          if (emp.name === currentUser.name || emp.phone === currentUser.phone || emp.id === currentUser.id) {
            emp.emergencyContactName = currentUser.emergencyContactName;
            emp.emergencyContactRelation = currentUser.emergencyContactRelation;
            emp.emergencyContactPhone = currentUser.emergencyContactPhone;
            empChanged = true;
          }
        });
        if (empChanged) {
          localStorage.setItem('employees', JSON.stringify(employees));
        }
      }

      showToast('Profile information updated successfully!', 'success');
      updateNavbar();
      renderProfilePage();
    });
  }

  // Password Update Form Handler
  const passForm = document.getElementById('profilePasswordForm');
  if (passForm && !passForm.dataset.bound) {
    passForm.dataset.bound = 'true';
    passForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const currPass = document.getElementById('profCurrPass').value;
      const newPass = document.getElementById('profNewPass').value;
      const confirmPass = document.getElementById('profConfirmPass').value;

      if (currPass !== currentUser.password) {
        showToast('Current password is incorrect.', 'danger');
        return;
      }
      if (newPass.length < 4) {
        showToast('New password must be at least 4 characters long.', 'danger');
        return;
      }
      if (newPass !== confirmPass) {
        showToast('New password and confirm password do not match.', 'danger');
        return;
      }

      currentUser.password = newPass;
      setCurrentUser(currentUser);

      const users = JSON.parse(localStorage.getItem('users') || '[]');
      const userIdx = users.findIndex(u => u.id === currentUser.id || u.email === currentUser.email);
      if (userIdx !== -1) {
        users[userIdx].password = newPass;
        localStorage.setItem('users', JSON.stringify(users));
      }

      showToast('Password updated successfully!', 'success');
      passForm.reset();
    });
  }
}

/* ==========================================================================
   7. TRAIN MANAGER DASHBOARD ENGINE (ALL 8 REQUIRED FEATURES)
   ========================================================================== */
function initTrainManagerDashboard() {
  const currentUser = getCurrentUser();
  if (!currentUser) {
    window.location.href = 'login.html';
    return;
  }

  // Assigned Station & Default Assigned Train
  const assignedStation = currentUser.station || 'Dhaka (Kamalapur)';
  let trains = JSON.parse(localStorage.getItem('trains') || '[]');
  
  // Filter trains corresponding to manager's assigned station
  let stationTrains = trains.filter(t => 
    t.source === assignedStation || 
    t.destination === assignedStation ||
    (t.source && t.source.includes(assignedStation.split(' ')[0])) ||
    (t.destination && t.destination.includes(assignedStation.split(' ')[0]))
  );

  if (stationTrains.length === 0) {
    stationTrains = trains; // Fallback to all if custom station
  }

  // Active Train State
  let activeTrainId = currentUser.assignedTrainId || stationTrains[0]?.id || 'TR-701';
  let activeTrain = trains.find(t => t.id === activeTrainId) || stationTrains[0] || {
    id: 'TR-701',
    name: 'Sonar Bangla Express',
    type: 'Intercity Super Fast',
    source: 'Dhaka (Kamalapur)',
    destination: 'Chattogram Junction',
    departure: '07:00 AM',
    arrival: '12:15 PM',
    duration: '5h 15m',
    platform: 'Platform #1',
    offDay: 'Saturday',
    fare: 650,
    status: 'Operational',
    delayMinutes: 0
  };

  // Populate Train Switcher & Station Badges
  const stationBadge = document.getElementById('tmStationBadge');
  if (stationBadge) stationBadge.textContent = `Assigned Station: ${assignedStation}`;

  const trainSelect = document.getElementById('tmTrainSelect');
  if (trainSelect) {
    trainSelect.innerHTML = stationTrains.map(t => `
      <option value="${t.id}" ${t.id === activeTrain.id ? 'selected' : ''}>
        ${t.name} (${t.id})
      </option>
    `).join('');

    trainSelect.addEventListener('change', (e) => {
      activeTrainId = e.target.value;
      activeTrain = trains.find(t => t.id === activeTrainId) || activeTrain;
      renderAllTrainManagerFeatures();
      showToast(`Switched active management to ${activeTrain.name}`, 'info');
    });
  }

  // Coach and Seat Configuration Mock Engine
  const coachesData = [
    { code: 'KA', name: 'Coach KA (AC Berth)', class: 'AC Berth', totalSeats: 36, bookedSeats: 32, fare: 1200, ac: 'Optimal (21°C)', power: 'Normal (230V)', cleanliness: 'Inspected' },
    { code: 'KHA', name: 'Coach KHA (Snigdha)', class: 'AC Chair / Snigdha', totalSeats: 60, bookedSeats: 52, fare: 850, ac: 'Optimal (22°C)', power: 'Normal (230V)', cleanliness: 'Inspected' },
    { code: 'GA', name: 'Coach GA (Shovon)', class: 'Shovon Chair', totalSeats: 70, bookedSeats: 58, fare: 450, ac: 'Natural / Fan', power: 'Normal', cleanliness: 'Clean' },
    { code: 'GHA', name: 'Coach GHA (Shovon)', class: 'Shovon Chair', totalSeats: 70, bookedSeats: 56, fare: 450, ac: 'Natural / Fan', power: 'Normal', cleanliness: 'Clean' },
    { code: 'UMA', name: 'Coach UMA (Guard/Luggage)', class: 'Brake Van', totalSeats: 20, bookedSeats: 14, fare: 350, ac: 'N/A', power: 'Normal', cleanliness: 'Audited' }
  ];

  let activeCoachCode = 'KA';

  // Render all 8 features function
  function renderAllTrainManagerFeatures() {
    // 1. FEATURE 1: View Assigned Train Details
    const headerTitle = document.getElementById('tmAssignedTrainHeader');
    if (headerTitle) headerTitle.textContent = `${activeTrain.name} (${activeTrain.id})`;

    const trainIdDisplay = document.getElementById('tmTrainIdDisplay');
    const trainSource = document.getElementById('tmTrainSource');
    const trainDest = document.getElementById('tmTrainDest');
    const trainDept = document.getElementById('tmTrainDept');
    const trainArr = document.getElementById('tmTrainArr');
    const trainDuration = document.getElementById('tmTrainDuration');
    const trainPlatform = document.getElementById('tmTrainPlatform');
    const trainOffDay = document.getElementById('tmTrainOffDay');
    const trainFare = document.getElementById('tmTrainFare');
    const trainTypeBadge = document.getElementById('tmTrainTypeBadge');

    if (trainIdDisplay) trainIdDisplay.textContent = activeTrain.id;
    if (trainSource) trainSource.textContent = activeTrain.source || assignedStation;
    if (trainDest) trainDest.textContent = activeTrain.destination || 'Chattogram Junction';
    if (trainDept) trainDept.textContent = activeTrain.departure || '07:00 AM';
    if (trainArr) trainArr.textContent = activeTrain.arrival || '12:15 PM';
    if (trainDuration) trainDuration.textContent = activeTrain.duration || '5h 15m';
    if (trainPlatform) trainPlatform.textContent = activeTrain.platform || 'Platform #1';
    if (trainOffDay) trainOffDay.textContent = activeTrain.offDay || 'Saturday';
    if (trainFare) trainFare.textContent = formatBDT(activeTrain.fare || 650);
    if (trainTypeBadge) trainTypeBadge.textContent = activeTrain.type || 'Intercity Express';

    // 11 Summary Cards Binding
    const totalCap = coachesData.reduce((acc, c) => acc + c.totalSeats, 0);
    const totalBooked = coachesData.reduce((acc, c) => acc + c.bookedSeats, 0);
    const avail = totalCap - totalBooked;
    const currentDelay = activeTrain.delayMinutes || 0;

    const cardAssignedTrain = document.getElementById('tmCardAssignedTrain');
    const cardTrainId = document.getElementById('tmCardTrainId');
    const cardStatus = document.getElementById('tmCardStatus');
    const cardCoaches = document.getElementById('tmCardCoaches');
    const cardSeats = document.getElementById('tmCardSeats');
    const cardAvailSeats = document.getElementById('tmCardAvailSeats');
    const cardOccSeats = document.getElementById('tmCardOccSeats');
    const cardPassengers = document.getElementById('tmCardPassengers');
    const cardNextStation = document.getElementById('tmCardNextStation');
    const cardDeptTime = document.getElementById('tmCardDeptTime');
    const cardSourceStation = document.getElementById('tmCardSourceStation');
    const cardArrTime = document.getElementById('tmCardArrTime');
    const cardDestStation = document.getElementById('tmCardDestStation');
    const cardDelayStatus = document.getElementById('tmCardDelayStatus');

    if (cardAssignedTrain) cardAssignedTrain.textContent = activeTrain.name;
    if (cardTrainId) cardTrainId.textContent = activeTrain.id;
    if (cardStatus) cardStatus.textContent = activeTrain.status || 'Operational';
    if (cardCoaches) cardCoaches.textContent = `${coachesData.length} Coaches`;
    if (cardSeats) cardSeats.textContent = `${totalCap} Total Seats`;
    if (cardAvailSeats) cardAvailSeats.textContent = `${avail} Seats`;
    if (cardOccSeats) cardOccSeats.textContent = `${totalBooked} Booked`;
    if (cardPassengers) cardPassengers.textContent = `${totalBooked} Passengers`;

    // Dynamic Next Station Calculation based on route
    const isChattogramRoute = (activeTrain.destination || '').includes('Chattogram') || (activeTrain.source || '').includes('Chattogram');
    const isSylhetRoute = (activeTrain.destination || '').includes('Sylhet');
    const isCoxRoute = (activeTrain.destination || '').includes('Cox');
    const nextStopName = isCoxRoute ? 'Chattogram Junction' : (isSylhetRoute ? 'Brahmanbaria' : (isChattogramRoute ? 'Bhairab Bazar' : 'Joydebpur Junction'));

    if (cardNextStation) cardNextStation.textContent = nextStopName;
    if (cardDeptTime) cardDeptTime.textContent = activeTrain.departure || '07:00 AM';
    if (cardSourceStation) cardSourceStation.textContent = activeTrain.source || 'Dhaka (Kamalapur)';
    if (cardArrTime) cardArrTime.textContent = activeTrain.arrival || '12:15 PM';
    if (cardDestStation) cardDestStation.textContent = activeTrain.destination || 'Chattogram Junction';
    if (cardDelayStatus) {
      cardDelayStatus.textContent = currentDelay > 0 ? `+${currentDelay} min delay` : 'On Time (0 min)';
      cardDelayStatus.className = currentDelay > 0 ? 'text-lg font-black text-amber-400' : 'text-lg font-black text-emerald-400';
    }

    // Top Overview Ribbon Metrics
    const metricStatus = document.getElementById('tmMetricStatus');
    const metricRoute = document.getElementById('tmMetricRoute');
    const metricDelay = document.getElementById('tmMetricDelay');
    const metricEstDept = document.getElementById('tmMetricEstDept');

    if (metricStatus) metricStatus.textContent = activeTrain.status || 'Operational';
    if (metricRoute) metricRoute.textContent = `${activeTrain.source || 'Dhaka'} ? ${activeTrain.destination || 'Chattogram'}`;
    if (metricDelay) {
      metricDelay.textContent = currentDelay > 0 ? `+${currentDelay} Min Delay` : 'On Time (0 min)';
      metricDelay.className = currentDelay > 0 ? 'text-base sm:text-lg font-bold text-amber-400' : 'text-base sm:text-lg font-bold text-emerald-400';
    }
    if (metricEstDept) metricEstDept.textContent = `Scheduled: ${activeTrain.departure || '07:00 AM'}`;

    // TRAIN JOURNEY / ROUTE FLOW (Feature: Vertical sequence with downward arrows ?)
    renderTrainJourneyRouteFlow();

    // 2. FEATURE 2: Train Status Management Form
    const statusSelect = document.getElementById('tmStatusSelect');
    if (statusSelect && activeTrain.status) {
      statusSelect.value = activeTrain.status;
    }

    // 4. FEATURE 4: Update Train Delay
    const delayBadge = document.getElementById('tmDelayBadge');
    const delayMinutesInput = document.getElementById('tmDelayMinutes');
    const estDeptTime = document.getElementById('tmEstDeptTime');

    if (delayBadge) {
      delayBadge.textContent = currentDelay > 0 ? `+${currentDelay} Min Delay` : 'On Time';
    }
    if (delayMinutesInput) {
      delayMinutesInput.value = currentDelay;
    }
    if (estDeptTime) {
      estDeptTime.textContent = calculateRevisedTime(activeTrain.departure || '07:00 AM', currentDelay);
    }

    // 5 & 6. FEATURES 5 & 6: View Coaches & Live Seat Status
    renderCoachTabsAndSeats();

    // 7. FEATURE 7: Train Occupancy Analytics
    renderOccupancyAnalytics();

    // 8. FEATURE 8: Render Emergency Dispatch History
    renderTrainManagerEmergencies();
  }

  // Render Train Manager Emergency Incidents Table
  function renderTrainManagerEmergencies() {
    const tbody = document.getElementById('tmEmergenciesTableBody');
    if (!tbody) return;

    const emergencies = JSON.parse(localStorage.getItem('emergencies') || '[]');
    // Show emergencies for this train or recent ones
    const trainEmg = emergencies.filter(e => e.trainId === activeTrain.id || emergencies.length <= 4);

    if (trainEmg.length === 0) {
      tbody.innerHTML = `<tr><td colspan="7" class="text-center py-6 text-slate-400">No emergency incidents or alerts dispatched for this train.</td></tr>`;
      return;
    }

    tbody.innerHTML = trainEmg.map(e => {
      let sevBadge = 'bg-amber-500/20 text-amber-300 border border-amber-500/40';
      if (e.severity && (e.severity.includes('Critical') || e.severity.includes('Immediate'))) {
        sevBadge = 'bg-rose-500/20 text-rose-300 border border-rose-500/50 font-black';
      }

      let statusBadge = e.status === 'Resolved' 
        ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/40' 
        : (e.status === 'Acknowledged' 
            ? 'bg-amber-500/20 text-amber-400 border border-amber-500/40' 
            : 'bg-rose-500/20 text-rose-400 border border-rose-500/40 animate-pulse');

      return `
        <tr class="border-b border-slate-700/50 hover:bg-slate-900/30">
          <td class="py-2.5"><strong class="font-mono text-rose-400 font-bold">${e.id}</strong></td>
          <td>
            <div class="font-bold text-white">${e.trainName || activeTrain.name}</div>
            <div class="text-[10px] font-mono text-slate-400">${e.trainId || activeTrain.id}</div>
          </td>
          <td class="font-semibold text-slate-200">${e.type}</td>
          <td><span class="px-2 py-0.5 rounded text-[10px] ${sevBadge}">${e.severity}</span></td>
          <td class="text-slate-300 font-medium">${e.location}</td>
          <td class="text-slate-400 text-[11px]">${e.reportedAt}</td>
          <td><span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold border ${statusBadge}">${e.status}</span></td>
        </tr>
      `;
    }).join('');
  }

