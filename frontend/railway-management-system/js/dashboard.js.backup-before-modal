  // Calculate revised departure time helper
  function calculateRevisedTime(timeStr, delayMins) {
    if (!delayMins || delayMins === 0) return `${timeStr} (On Time)`;
    return `${timeStr} + ${delayMins}m buffer`;
  }

  // Render Coach Tabs & Interactive Seats (Features 5 & 6)
  function renderCoachTabsAndSeats() {
    const tabsContainer = document.getElementById('tmCoachTabs');
    const coachInfoContainer = document.getElementById('tmSelectedCoachInfo');
    const seatMapGrid = document.getElementById('tmSeatMapGrid');

    if (!tabsContainer || !seatMapGrid) return;

    // Tabs
    tabsContainer.innerHTML = coachesData.map(c => `
      <button type="button" onclick="selectCoach('${c.code}')" class="px-2.5 py-1 text-xs font-bold rounded-lg transition-all cursor-pointer ${c.code === activeCoachCode ? 'bg-cyan-500 text-white shadow' : 'text-slate-400 hover:text-white hover:bg-slate-800'}">
        ${c.code}
      </button>
    `).join('');

    const currentCoach = coachesData.find(c => c.code === activeCoachCode) || coachesData[0];

    // Info header
    if (coachInfoContainer) {
      coachInfoContainer.innerHTML = `
        <div class="flex items-center gap-3">
          <span class="font-bold text-white text-sm">Coach ${currentCoach.code}:</span>
          <span class="text-cyan-300 font-semibold">${currentCoach.class}</span>
        </div>
        <div class="flex items-center gap-4 text-slate-300">
          <span>AC: <strong class="text-emerald-400">${currentCoach.ac}</strong></span>
          <span>Power: <strong class="text-emerald-400">${currentCoach.power}</strong></span>
          <span>Hygiene: <strong class="text-emerald-400">${currentCoach.cleanliness}</strong></span>
          <span>Capacity: <strong class="text-white font-mono">${currentCoach.bookedSeats}/${currentCoach.totalSeats}</strong></span>
        </div>
      `;
    }

    // Interactive Seat Grid (Feature 6)
    let seatsHtml = '';
    for (let i = 1; i <= currentCoach.totalSeats; i++) {
      const isBooked = i <= currentCoach.bookedSeats;
      const isVip = (i === 1 || i === 2);
      
      let seatClass = 'bg-emerald-500/10 border-emerald-500/40 text-emerald-300 hover:bg-emerald-500/20';
      let statusText = 'Available for booking';
      
      if (isVip) {
        seatClass = 'bg-purple-500/20 border-purple-400/50 text-purple-200 hover:bg-purple-500/30';
        statusText = 'Reserved (Railway Official / VIP)';
      } else if (isBooked) {
        seatClass = 'bg-sky-500/20 border-sky-400/50 text-sky-200 hover:bg-sky-500/30';
        statusText = `Booked (Ticket #TKT-89${i})`;
      }

      seatsHtml += `
        <button type="button" onclick="inspectSeat('${currentCoach.code}', ${i}, '${statusText}')" class="p-2 text-center rounded-lg border font-mono font-bold text-xs transition-all cursor-pointer ${seatClass}" title="Seat ${currentCoach.code}-${i}: ${statusText}">
          ${currentCoach.code}-${i}
        </button>
      `;
    }
    seatMapGrid.innerHTML = seatsHtml;
  }

  // Feature 7: Occupancy Analytics
  function renderOccupancyAnalytics() {
    const totalCap = coachesData.reduce((acc, c) => acc + c.totalSeats, 0);
    const totalBooked = coachesData.reduce((acc, c) => acc + c.bookedSeats, 0);
    const avail = totalCap - totalBooked;
    const occRate = ((totalBooked / totalCap) * 100).toFixed(1);

    const occPercentText = document.getElementById('tmOccPercentText');
    const occProgressBar = document.getElementById('tmOccProgressBar');
    const occBookedCount = document.getElementById('tmOccBookedCount');
    const occAvailCount = document.getElementById('tmOccAvailCount');
    const occTotalCount = document.getElementById('tmOccTotalCount');
    const metricOccupancy = document.getElementById('tmMetricOccupancy');
    const metricSeatsCount = document.getElementById('tmMetricSeatsCount');

    if (occPercentText) occPercentText.textContent = `${occRate}% Occupied`;
    if (occProgressBar) occProgressBar.style.width = `${occRate}%`;
    if (occBookedCount) occBookedCount.textContent = totalBooked;
    if (occAvailCount) occAvailCount.textContent = avail;
    if (occTotalCount) occTotalCount.textContent = `${totalCap} Seats`;
    if (metricOccupancy) metricOccupancy.textContent = `${occRate}% Booked`;
    if (metricSeatsCount) metricSeatsCount.textContent = `${totalBooked} / ${totalCap} Seats`;
  }

  // Global window functions for Coach Selection and Seat Inspection
  window.selectCoach = function(code) {
    activeCoachCode = code;
    renderCoachTabsAndSeats();
  };

  window.inspectSeat = function(coach, seatNum, status) {
    showToast(`Seat ${coach}-${seatNum}: ${status}`, 'info');
  };

  // Form Submissions:
  // 1. Train Status Form (Feature 2)
  const statusForm = document.getElementById('tmStatusUpdateForm');
  if (statusForm && !statusForm.dataset.bound) {
    statusForm.dataset.bound = 'true';
    statusForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const newStatus = document.getElementById('tmStatusSelect').value;
      const note = document.getElementById('tmStatusNote').value.trim();

      // Call real backend API
      apiCall('PUT', `/api/manager/trains/${encodeURIComponent(activeTrain.id)}/status`, {
        status: newStatus.toUpperCase(),
        cause: note
      }).catch(() => {});

      activeTrain.status = newStatus;
      const allTrains = JSON.parse(localStorage.getItem('trains') || '[]');
      const tIdx = allTrains.findIndex(t => t.id === activeTrain.id);
      if (tIdx !== -1) {
        allTrains[tIdx].status = newStatus;
        if (newStatus === 'Delayed' && (!allTrains[tIdx].delayMinutes || allTrains[tIdx].delayMinutes === 0)) {
          allTrains[tIdx].delayMinutes = 15;
          activeTrain.delayMinutes = 15;
        }
        localStorage.setItem('trains', JSON.stringify(allTrains));
      }

      if (newStatus === 'Delayed' || newStatus === 'Cancelled') {
        dispatchPassengerDelayNotification(activeTrain.id, activeTrain.delayMinutes || 15, `Train Operational Status: ${newStatus}`);
      }

      const statusModal = document.getElementById('tmStatusModalOverlay');
      if (statusModal) statusModal.classList.remove('active');

      const lastStatusEl = document.getElementById('tmLastStatusUpdate');
      if (lastStatusEl) {
        const timeNow = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        lastStatusEl.textContent = `Today, ${timeNow} (${newStatus})`;
      }

      renderAllTrainManagerFeatures();
      showToast(`Train status updated to "${newStatus}"! Broadcasted to central station board.`, 'success');
    });
  }

  // 2. Train Delay Form (Feature 4)
  const delayForm = document.getElementById('tmDelayForm');
  if (delayForm && !delayForm.dataset.bound) {
    delayForm.dataset.bound = 'true';
    delayForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const delayMins = parseInt(document.getElementById('tmDelayMinutes').value || '0', 10);
      const reason = document.getElementById('tmDelayReason').value;

      // Call real backend API
      apiCall('PUT', `/api/manager/trains/${encodeURIComponent(activeTrain.id)}/delay`, {
        delay_minutes: delayMins,
        reason: reason
      }).catch(() => {});

      activeTrain.delayMinutes = delayMins;
      activeTrain.delayReason = reason;
      const allTrains = JSON.parse(localStorage.getItem('trains') || '[]');
      const tIdx = allTrains.findIndex(t => t.id === activeTrain.id);
      if (tIdx !== -1) {
        allTrains[tIdx].delayMinutes = delayMins;
        allTrains[tIdx].delayReason = reason;
        if (delayMins > 0) {
          allTrains[tIdx].status = 'Delayed';
          activeTrain.status = 'Delayed';
        } else if (allTrains[tIdx].status === 'Delayed') {
          allTrains[tIdx].status = 'Operational';
          activeTrain.status = 'Operational';
        }
        localStorage.setItem('trains', JSON.stringify(allTrains));
      }

      // Dispatch alert notifications to all passengers who booked this train
      const notifiedCount = dispatchPassengerDelayNotification(activeTrain.id, delayMins, reason);

      const delayModal = document.getElementById('tmDelayModalOverlay');
      if (delayModal) delayModal.classList.remove('active');

      renderAllTrainManagerFeatures();
      showToast(`Schedule delay updated to +${delayMins} mins (${reason}). ${notifiedCount} booked passenger(s) notified!`, 'success');
    });
  }

  // 4. Emergency Broadcast Form (Feature 8)
  const emergForm = document.getElementById('tmEmergencyForm');
  if (emergForm && !emergForm.dataset.bound) {
    emergForm.dataset.bound = 'true';
    emergForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const type = document.getElementById('tmEmergType').value;
      const severity = document.getElementById('tmEmergSeverity').value;
      const location = document.getElementById('tmEmergLocation').value.trim();
      const desc = document.getElementById('tmEmergDesc').value.trim();

      if (!location || !desc) {
        showToast('Please state the emergency location and details.', 'danger');
        return;
      }

      // Call real backend API
      apiCall('POST', '/api/manager/incidents', {
        train_id: activeTrain.id,
        incident_type: type,
        priority: severity.includes('Critical') ? 'CRITICAL' : 'HIGH',
        description: `Location: ${location}. Details: ${desc}`
      }).catch(() => {});

      const newEmergency = {
        id: `EMG-${Math.floor(200 + Math.random() * 800)}`,
        trainId: activeTrain.id,
        trainName: activeTrain.name,
        type: type,
        severity: severity,
        location: location,
        description: desc,
        reportedBy: `${currentUser.name || 'Train Manager'} (Train Manager)`,
        reportedAt: 'Just now',
        status: 'Active'
      };

      const emergencies = JSON.parse(localStorage.getItem('emergencies') || '[]');
      emergencies.unshift(newEmergency);
      localStorage.setItem('emergencies', JSON.stringify(emergencies));

      // Broadcast to system notifications
      const notifs = JSON.parse(localStorage.getItem('system_notifications') || '[]');
      notifs.unshift({
        id: `NOTIF-${Date.now()}`,
        type: 'emergency',
        title: `¨ EMERGENCY ALERT: ${activeTrain.name} (${activeTrain.id})`,
        message: `${type} at ${location}. Severity: ${severity}. Control HQ & Station Master dispatched.`,
        timestamp: new Date().toISOString(),
        timeStr: 'Just now',
        read: false
      });
      localStorage.setItem('system_notifications', JSON.stringify(notifs));

      const emergModal = document.getElementById('tmEmergencyModalOverlay');
      if (emergModal) emergModal.classList.remove('active');
      emergForm.reset();

      renderTrainManagerEmergencies();
      showToast(`¨ HIGH PRIORITY EMERGENCY DISPATCHED: #${newEmergency.id} (${type} at ${location}) sent to Central Control HQ!`, 'danger');
    });
  }

  // 5. Train Schedule Update Request Modal Handler
  const openSchedBtn = document.getElementById('openScheduleModalBtn');
  const schedModalOverlay = document.getElementById('tmScheduleModalOverlay');
  const schedUpdateForm = document.getElementById('tmScheduleUpdateModalForm');

  if (openSchedBtn && schedModalOverlay && !openSchedBtn.dataset.bound) {
    openSchedBtn.dataset.bound = 'true';
    openSchedBtn.addEventListener('click', () => {
      const trainNameField = document.getElementById('tmSchedTrainName');
      if (trainNameField) trainNameField.value = `${activeTrain.name} (${activeTrain.id})`;
      const timesDisp = document.getElementById('tmSchedDispTimes');
      if (timesDisp) timesDisp.textContent = `${activeTrain.departure || '07:00 AM'} ? ${activeTrain.arrival || '12:15 PM'}`;
      const routeDisp = document.getElementById('tmSchedDispRoute');
      if (routeDisp) routeDisp.textContent = `${activeTrain.source || assignedStation || 'Dhaka'} ? ${activeTrain.destination || 'Chattogram'}`;
      const platDisp = document.getElementById('tmSchedDispPlatform');
      if (platDisp) platDisp.textContent = activeTrain.platform || 'Platform #1';

      schedModalOverlay.classList.add('active');
    });
  }

  if (schedUpdateForm && !schedUpdateForm.dataset.bound) {
    schedUpdateForm.dataset.bound = 'true';
    schedUpdateForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      const requestedChange =
        document.getElementById('tmSchedRequestedChange').value.trim();

      const reason =
        document.getElementById('tmSchedReason').value.trim();

      if (!requestedChange) {
        showToast(
          'Please describe the requested schedule change.',
          'danger'
        );
        return;
      }

      const result = await apiCall(
        'POST',
        '/api/manager/schedule-requests',
        {
          train_id: activeTrain.id,
          schedule_id:
            activeTrain.scheduleId ||
            activeTrain.schedule_id ||
            null,
          requested_change: requestedChange,
          reason: reason
        }
      );

      if (!result.ok) {
        showToast(
          result.error ||
          'Failed to submit schedule update request.',
          'danger'
        );
        return;
      }

      const requestId =
        result.data?.request_id ||
        result.data?.REQUEST_ID ||
        'new request';

      schedModalOverlay.classList.remove('active');
      schedUpdateForm.reset();

      showToast(
        `Schedule update request ${requestId} submitted for ${activeTrain.name} (Status: Pending)!`,
        'success'
      );

      // Do not refresh the CRUD schedule manager here.
      // The request was already saved to SCHEDULE_UPDATE_REQUEST.
    });
  }

  // Initial render
  renderAllTrainManagerFeatures();
}

























