/**
 * Generic Admin & User Dashboard Engine
 * Implements CRUD Data Tables, Search, Filter, Sort, Pagination & Modals for all 15 Admin Pages
 */

document.addEventListener('DOMContentLoaded', () => {
  // Page Identifier Router
  const pagePath = window.location.pathname.split('/').pop();

  if (pagePath === 'user-dashboard.html') {
    renderUserDashboard();
  } else if (pagePath === 'train-manager-dashboard.html') {
    initTrainManagerDashboard();
  } else if (pagePath === 'profile.html') {
    renderProfilePage();
  } else if (pagePath === 'admin-dashboard.html') {
    renderAdminDashboard();
  } else if (pagePath === 'my-tickets.html') {
    renderMyTicketsPage();
  } else if (pagePath === 'cancellation.html') {
    renderCancellationPage();
  } else if (pagePath === 'refund.html') {
    renderRefundPage();
  } else if (pagePath === 'complaint.html') {
    renderComplaintPage();
  } else if (pagePath === 'lost-item.html') {
    renderLostItemPage();
  } else if (pagePath.startsWith('manage-')) {
    if (typeof initDatabaseCrudPage === 'function') {
        initDatabaseCrudPage(pagePath);
    } else {
        if (pagePath !== 'manage-lost-items.html' && pagePath !== 'manage-platforms.html') {
            initAdminCrudTable(pagePath);
        }
    }
 }
});

/* ==========================================================================
   1. USER DASHBOARD (SEARCH & BOOK + PERSISTENT MY TICKETS)
   ========================================================================== */
function renderUserDashboard() {
  const currentUser = getCurrentUser();
  if (!currentUser) {
    window.location.href = 'login.html';
    return;
  }

  // Profile Info
  const nameEl = document.getElementById('dashUserName');
  const emailEl = document.getElementById('dashUserEmail');
  const phoneEl = document.getElementById('dashUserPhone');
  if (nameEl) nameEl.textContent = currentUser.name || 'Passenger';
  if (emailEl) emailEl.textContent = currentUser.email || 'user@railway.com';
  if (phoneEl) phoneEl.textContent = currentUser.phone || '01711223344';

  // Stats
  const tickets = JSON.parse(localStorage.getItem('tickets') || '[]');
  const myTickets = tickets.filter(t => t.userId === currentUser.id || t.passengerPhone === currentUser.phone || t.userId === 'USR-1001');

  const activeTicketsCount = myTickets.filter(t => t.bookingStatus === 'Confirmed').length;
  const totalSpent = myTickets.reduce((acc, t) => acc + (t.grandTotal || 0), 0);

  const activeEl = document.getElementById('userActiveTickets');
  const spentEl = document.getElementById('userTotalSpent');
  if (activeEl) activeEl.textContent = activeTicketsCount;
  if (spentEl) spentEl.textContent = formatBDT(totalSpent);

  // Lost Item Claims Count
  const allLost = JSON.parse(localStorage.getItem('lostItems') || '[]');
  const myLost = allLost.filter(l => l.userId === currentUser.id || l.phone === currentUser.phone || (!l.userId && currentUser.id === 'USR-1001'));
  const lostCountEl = document.getElementById('userLostItemsCount');
  if (lostCountEl) lostCountEl.textContent = myLost.length;

  // Real-Time Delay Notification Banner for Booked Passenger Trains
  renderPassengerDelayAlertBanner('passengerDelayAlertContainer');

  // Show appropriate placeholder in the delay notifications section
  // based on whether the passenger has bookings and whether any are delayed
  (function updateDelayNotificationPlaceholders() {
    const noDelayEl = document.getElementById('passengerNoDelayPlaceholder');
    const noBookingEl = document.getElementById('passengerNoBookingPlaceholder');
    if (!noDelayEl && !noBookingEl) return;

    const allTickets = JSON.parse(localStorage.getItem('tickets') || '[]');
    const myActiveTickets = allTickets.filter(t =>
      (t.userId === currentUser.id || t.passengerPhone === currentUser.phone || t.userId === 'USR-1001') &&
      t.bookingStatus === 'Confirmed'
    );

    // Mirror delay check logic from getPassengerDelayAlerts() in main.js
    const allTrains = JSON.parse(localStorage.getItem('trains') || '[]');
    const dismissed = JSON.parse(sessionStorage.getItem('dismissed_delay_alerts') || '[]');
    const hasActiveDelays = myActiveTickets.some(t => {
      if (dismissed.includes(t.ticketId || t.id)) return false;
      const matchedTrain = allTrains.find(tr => tr.id === t.trainId || tr.name === t.trainName);
      const delayMins = (matchedTrain ? matchedTrain.delayMinutes : 0) || t.delayMinutes || 0;
      return delayMins > 0;
    });

    if (noBookingEl) noBookingEl.style.display = (myActiveTickets.length === 0) ? 'block' : 'none';
    if (noDelayEl) noDelayEl.style.display = (myActiveTickets.length > 0 && !hasActiveDelays) ? 'block' : 'none';
  })();

  // 1. Search & Book Ticket Section Engine
  const fromSelect = document.getElementById('dashSearchFrom');
  const toSelect = document.getElementById('dashSearchTo');
  const dateInput = document.getElementById('dashSearchDate');
  const searchForm = document.getElementById('dashTrainSearchForm');
  const resultsContainer = document.getElementById('dashSearchResultsContainer');
  const resultsList = document.getElementById('dashTrainResultsList');
  const resultsCountBadge = document.getElementById('dashResultsCountBadge');

  const stations = JSON.parse(localStorage.getItem('stations') || '[]');
  const defaultStationList = [
    { name: 'Dhaka (Kamalapur)' },
    { name: 'Dhaka Airport' },
    { name: 'Chattogram Junction' },
    { name: 'Cox\'s Bazar Station' },
    { name: 'Sylhet Station' },
    { name: 'Rajshahi Station' },
    { name: 'Khulna Station' },
    { name: 'Cumilla Station' },
    { name: 'Bhairab Bazar' },
    { name: 'Feni Junction' }
  ];
  const stationOptions = (stations.length > 0 ? stations : defaultStationList);

  if (fromSelect && toSelect) {
    const fromHtml = stationOptions.map(s => `<option value="${s.name}">${s.name}</option>`).join('');
    const toHtml = [...stationOptions].reverse().map(s => `<option value="${s.name}">${s.name}</option>`).join('');
    
    fromSelect.innerHTML = fromHtml;
    toSelect.innerHTML = toHtml;
    
    // Set default distinct selections
    fromSelect.value = 'Dhaka (Kamalapur)';
    toSelect.value = 'Chattogram Junction';
  }

  if (dateInput) {
    const today = new Date().toISOString().split('T')[0];
    dateInput.value = today;
    dateInput.min = today;
  }

  function renderTrainSearchResults(sourceQuery = '', destQuery = '') {
    if (!resultsList) return;
    const allTrains = JSON.parse(localStorage.getItem('trains') || '[]');
    
    let matchedTrains = allTrains;
    if (sourceQuery && destQuery && sourceQuery !== destQuery) {
      const srcTerm = sourceQuery.split(' ')[0].toLowerCase();
      const dstTerm = destQuery.split(' ')[0].toLowerCase();
      
      matchedTrains = allTrains.filter(t => {
        const tSrc = (t.source || '').toLowerCase();
        const tDst = (t.destination || '').toLowerCase();
        return (tSrc.includes(srcTerm) && tDst.includes(dstTerm)) ||
               (tSrc.includes(srcTerm) && !destQuery) ||
               (tDst.includes(dstTerm) && !sourceQuery);
      });
    }

    if (matchedTrains.length === 0) {
      matchedTrains = allTrains.slice(0, 4); // Show top intercity trains if specific route has no direct train
    }

    if (resultsCountBadge) {
      resultsCountBadge.textContent = `${matchedTrains.length} Trains Available`;
    }

    resultsList.innerHTML = matchedTrains.map(t => {
      const availSeats = t.availableSeats !== undefined ? t.availableSeats : Math.floor(40 + Math.random() * 80);
      const fare = t.fare || 650;
      const duration = t.duration || '5h 15m';
      const dept = t.departure || '07:00 AM';
      const arr = t.arrival || '12:15 PM';

      return `
        <div class="p-4 bg-slate-50 border border-slate-200 rounded-xl hover:shadow-md transition-all">
          <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-3">
            <div>
              <div class="flex items-center gap-2">
                <h4 class="text-sm font-bold text-slate-800" style="margin: 0;">${t.name}</h4>
                <span class="badge badge-navy text-[10px] font-mono">${t.id}</span>
                <span class="badge ${t.status === 'Operational' ? 'badge-success' : 'badge-warning'} text-[10px]">${t.status || 'Operational'}</span>
              </div>
              <div class="text-xs text-slate-600 mt-1 flex flex-wrap items-center gap-3">
                <span>?? <strong>${dept}</strong> (${t.source})</span>
                <span>?</span>
                <span>?? <strong>${arr}</strong> (${t.destination})</span>
                <span class="text-slate-400">Time ?? ${duration}</span>
              </div>
            </div>

            <div class="flex items-center gap-4 w-full md:w-auto justify-between md:justify-end pt-2 md:pt-0 border-t md:border-t-0 border-slate-200">
              <div class="text-right">
                <div class="text-xs text-emerald-600 font-bold">? ${availSeats} Seats Available</div>
                <div class="text-sm font-black text-slate-900">${formatBDT(fare)} <span class="text-[10px] font-normal text-slate-500">/ person</span></div>
              </div>
              <button type="button" onclick="startBooking('${t.id}')" class="btn btn-primary btn-sm px-4 py-2 font-bold cursor-pointer shadow-sm">
                Book Now ?
              </button>
            </div>
          </div>
        </div>
      `;
    }).join('');
  }

  // Initial render of available trains
  renderTrainSearchResults('Dhaka (Kamalapur)', 'Chattogram Junction');

  if (searchForm && !searchForm.dataset.bound) {
    searchForm.dataset.bound = 'true';
    searchForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const fromVal = fromSelect ? fromSelect.value : '';
      const toVal = toSelect ? toSelect.value : '';
      const dateVal = dateInput ? dateInput.value : '';
      const passVal = document.getElementById('dashSearchPassengers')?.value || '1';

      if (fromVal === toVal) {
        showToast('Origin and Destination stations cannot be the same.', 'warning');
        return;
      }

      showToast(`Searching trains from ${fromVal} to ${toVal}...`, 'info');
      renderTrainSearchResults(fromVal, toVal);
    });
  }

  // 2. Persistent MY TICKETS Card Rendering
  renderPersistentMyTickets();

