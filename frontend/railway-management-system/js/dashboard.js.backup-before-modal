let currentAdminEmergFilter = 'all';

window.filterAdminEmergencies = function(filter) {
  currentAdminEmergFilter = filter;
  renderAdminEmergenciesTable(filter);
};

window.renderAdminEmergenciesTable = function(filter = currentAdminEmergFilter) {
  const tbody = document.getElementById('admEmergenciesTableBody');
  if (!tbody) return;

  const emergencies = JSON.parse(localStorage.getItem('emergencies') || '[]');
  let filtered = emergencies;
  if (filter && filter !== 'all') {
    filtered = emergencies.filter(e => e.status === filter);
  }

  const activeCount = emergencies.filter(e => e.status === 'Active').length;
  const countEl = document.getElementById('admActiveEmergencies');
  if (countEl) countEl.textContent = activeCount;
  const badgeEl = document.getElementById('admEmergenciesCountBadge');
  if (badgeEl) badgeEl.textContent = `${activeCount} Active`;

  if (filtered.length === 0) {
    tbody.innerHTML = `<tr><td colspan="9" class="text-center py-6 text-slate-400">No emergency reports found for selected filter (${filter}).</td></tr>`;
    return;
  }

  tbody.innerHTML = filtered.map(e => {
    let sevBadge = 'bg-amber-500/20 text-amber-300 border border-amber-500/40';
    if (e.severity && (e.severity.includes('Critical') || e.severity.includes('Immediate'))) {
      sevBadge = 'bg-rose-500/20 text-rose-300 border border-rose-500/50 font-black';
    }

    let statusBadge = 'bg-rose-500/20 text-rose-400 border border-rose-500/40 animate-pulse';
    if (e.status === 'Acknowledged') statusBadge = 'bg-amber-500/20 text-amber-400 border border-amber-500/40';
    if (e.status === 'Resolved') statusBadge = 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/40';

    return `
      <tr class="border-b border-slate-700/50 hover:bg-slate-900/30">
        <td class="py-2.5"><strong class="font-mono text-rose-400 font-bold">${e.id}</strong></td>
        <td>
          <div class="font-bold text-white">${e.trainName}</div>
          <div class="font-mono text-[10px] text-slate-400">${e.trainId}</div>
        </td>
        <td class="font-semibold text-slate-200">${e.type}</td>
        <td><span class="px-2 py-0.5 rounded text-[10px] ${sevBadge}">${e.severity}</span></td>
        <td class="text-slate-300 font-medium">${e.location}</td>
        <td>
          <div class="text-slate-300 text-[11px] font-medium">${e.reportedBy || 'Train Manager'}</div>
          <div class="text-slate-500 text-[10px]">${e.reportedAt}</div>
        </td>
        <td class="max-w-[180px] truncate text-slate-300" title="${e.description}">${e.description}</td>
        <td><span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold border ${statusBadge}">${e.status}</span></td>
        <td style="white-space: nowrap;">
          ${e.status === 'Active' ? `
            <button onclick="adminAcknowledgeEmergency('${e.id}')" class="px-2.5 py-1 text-xs font-bold rounded-lg bg-amber-600 hover:bg-amber-500 text-white transition-all shadow cursor-pointer mr-1">Acknowledge</button>
            <button onclick="adminResolveEmergency('${e.id}')" class="px-2.5 py-1 text-xs font-bold rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white transition-all shadow cursor-pointer">Resolve</button>
          ` : (e.status === 'Acknowledged' ? `
            <button onclick="adminResolveEmergency('${e.id}')" class="px-2.5 py-1 text-xs font-bold rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white transition-all shadow cursor-pointer">Resolve</button>
          ` : `
            <span class="text-emerald-400 font-bold text-xs">? Cleared</span>
          `)}
        </td>
      </tr>
    `;
  }).join('');
};

window.adminAcknowledgeEmergency = function(id) {
  const emergencies = JSON.parse(localStorage.getItem('emergencies') || '[]');
  const idx = emergencies.findIndex(e => e.id === id);
  if (idx !== -1) {
    emergencies[idx].status = 'Acknowledged';
    localStorage.setItem('emergencies', JSON.stringify(emergencies));
    showToast(`Emergency #${id} marked as ACKNOWLEDGED by Control HQ. Priority assistance dispatched.`, 'info');
    renderAdminEmergenciesTable();
  }
};

window.adminResolveEmergency = function(id) {
  const emergencies = JSON.parse(localStorage.getItem('emergencies') || '[]');
  const idx = emergencies.findIndex(e => e.id === id);
  if (idx !== -1) {
    emergencies[idx].status = 'Resolved';
    localStorage.setItem('emergencies', JSON.stringify(emergencies));
    showToast(`Emergency #${id} marked as RESOLVED and cleared from active alarms!`, 'success');
    renderAdminEmergenciesTable();
  }
};

