    const ticketsContainer = document.getElementById('dashMyTicketsContainer');
    const badgeCount = document.getElementById('myTicketsCountBadge');
    if (!ticketsContainer) return;

    const allTickets = JSON.parse(localStorage.getItem('tickets') || '[]');
    const userTickets = allTickets.filter(t => t.userId === currentUser.id || t.passengerPhone === currentUser.phone || t.userId === 'USR-1001');

    if (badgeCount) {
      badgeCount.textContent = `${userTickets.length} Ticket${userTickets.length === 1 ? '' : 's'}`;
    }

    if (userTickets.length === 0) {
      ticketsContainer.innerHTML = `
        <div class="text-center py-8 px-4 bg-slate-50 rounded-xl border border-dashed border-slate-300">
          <div class="text-3xl mb-2">???</div>
          <h3 class="text-sm font-bold text-slate-700">No tickets yet</h3>
          <p class="text-xs text-slate-500 max-w-sm mx-auto mt-1 mb-4">You haven't booked any train journeys yet. Use the search tool above to book your seats across Bangladesh.</p>
          <button onclick="document.getElementById('searchBookTicketSection').scrollIntoView({behavior: 'smooth'})" class="btn btn-primary btn-sm px-4 py-1.5 font-bold">
            ?? Search & Book Ticket
