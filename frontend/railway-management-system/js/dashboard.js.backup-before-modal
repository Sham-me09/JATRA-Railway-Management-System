async function renderLostItemList(activeFilter = 'all', searchQuery = '') {
  const container = document.getElementById('myLostClaimsContainer');
  const statTotal = document.getElementById('statMyTotalClaims');
  const statReview = document.getElementById('statUnderReview');
  const statFound = document.getElementById('statFoundReady');
  const statResolved = document.getElementById('statResolvedCount');

  let allItems = [];

  try {
    allItems = await databaseGet('lost-item.html');
  } catch (error) {
    console.error('[PASSENGER LOST ITEMS] Failed to load from Oracle:', error);

    if (container) {
      container.innerHTML = `
        <div class="text-center py-12 px-4 bg-slate-50 rounded-2xl border border-dashed border-slate-200">
          <div class="text-4xl mb-2">⚠️</div>
          <div class="text-sm font-bold text-slate-700">Unable to Load Lost Property Records</div>
          <p class="text-xs text-slate-500 max-w-sm mx-auto mt-1">
            Please make sure the backend server is running and try again.
          </p>
        </div>
      `;
    }

    return;
  }

  /*
   * LOST_ITEM has three database statuses:
   * UNCLAIMED, CLAIMED, DISPOSED
   *
   * Passenger view shows ALL records.
   * Passenger has no update/cancel/recover permission.
   */
  const normalizedItems = Array.isArray(allItems) ? allItems : [];

  // Update quick statistics using actual database statuses.
  if (statTotal) {
    statTotal.textContent = normalizedItems.length;
  }

  if (statReview) {
    statReview.textContent = normalizedItems.filter(
      l => String(l.status || '').toUpperCase() === 'UNCLAIMED'
    ).length;
  }

  if (statFound) {
    statFound.textContent = 0;
  }

  if (statResolved) {
    statResolved.textContent = normalizedItems.filter(
      l => String(l.status || '').toUpperCase() === 'CLAIMED'
    ).length;
  }

  if (!container) return;

  // Apply status filter.
  let displayedItems = normalizedItems;

  if (activeFilter && activeFilter !== 'all') {
    const wantedStatus = String(activeFilter).toUpperCase();

    displayedItems = displayedItems.filter(item =>
      String(item.status || '').toUpperCase() === wantedStatus
    );
  }

  // Apply search.
  if (searchQuery) {
    const q = searchQuery.toLowerCase();

    displayedItems = displayedItems.filter(item => {
      return (
        String(item.item || '').toLowerCase().includes(q) ||
        String(item.id || '').toLowerCase().includes(q) ||
        String(item.train || '').toLowerCase().includes(q) ||
        String(item.station || '').toLowerCase().includes(q) ||
        String(item.description || '').toLowerCase().includes(q)
      );
    });
  }

  if (displayedItems.length === 0) {
    container.innerHTML = `
      <div class="text-center py-12 px-4 bg-slate-50 rounded-2xl border border-dashed border-slate-200">
        <div class="text-4xl mb-2">📦</div>
        <div class="text-sm font-bold text-slate-700">No Lost Property Records Found</div>
        <p class="text-xs text-slate-500 max-w-sm mx-auto mt-1">
          ${searchQuery
            ? 'No lost property records match your search criteria.'
            : 'There are currently no lost property records available.'}
        </p>
      </div>
    `;
    return;
  }

  container.innerHTML = displayedItems.map(item => {
    const dbStatus = String(item.status || 'UNCLAIMED').toUpperCase();

    let statusClass = 'bg-amber-100 text-amber-800 border-amber-300';
    let statusIcon = '🔎';
    let statusLabel = 'Unclaimed';
    let statusDesc = 'Lost item has been registered and is currently unclaimed.';

    if (dbStatus === 'CLAIMED') {
      statusClass = 'bg-sky-100 text-sky-700 border-sky-200';
      statusIcon = '✓';
      statusLabel = 'Claimed';
      statusDesc = 'Lost item has been claimed.';
    } else if (dbStatus === 'DISPOSED') {
      statusClass = 'bg-slate-100 text-slate-600 border-slate-300';
      statusIcon = '•';
      statusLabel = 'Disposed';
      statusDesc = 'Lost item record is marked as disposed.';
    }

    return `
      <div class="p-4 rounded-xl border border-slate-200 bg-white hover:border-sky-300 transition-all shadow-sm flex flex-col justify-between gap-3">

        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <div class="flex items-center gap-2">
            <span class="px-2 py-0.5 text-xs font-mono font-bold rounded bg-slate-800 text-white">
              ${item.id || 'N/A'}
            </span>

            <span class="px-2 py-0.5 text-xs font-semibold rounded bg-sky-50 text-sky-700 border border-sky-200">
              Lost Property
            </span>

            <span class="text-xs text-slate-400">
              📅 ${item.date || 'N/A'}
            </span>
          </div>

          <div class="flex items-center gap-1">
            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold border ${statusClass}">
              <span>${statusIcon}</span> ${statusLabel}
            </span>
          </div>
        </div>

        <div>
          <h4 class="text-base font-bold text-slate-800">
            ${item.item || 'N/A'}
          </h4>

          <div class="text-xs text-slate-600 mt-1 flex flex-wrap items-center gap-3">
            <span>
              🚆 <strong>Train:</strong> ${item.train || 'N/A'}
            </span>

            ${item.station ? `
              <span>
                📍 <strong>Station:</strong> ${item.station}
              </span>
            ` : ''}
          </div>

          <p class="text-xs text-slate-500 mt-2 bg-slate-50 p-2.5 rounded-lg border border-slate-100 italic">
            "${item.description || 'No additional notes'}"
          </p>
        </div>

        <div class="pt-2 border-t border-slate-100 flex flex-wrap items-center justify-between gap-2">
          <span class="text-[11px] text-slate-400">
            ${statusDesc}
