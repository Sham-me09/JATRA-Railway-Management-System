/* ==========================================================================
   SCHEDULE UPDATE REQUESTS HANDLER (TRAIN MANAGER & ADMIN)
   ========================================================================== */
function initScheduleRequestsManager(pagePath, currentUser) {
  if (pagePath !== 'manage-schedules.html') return;

  const userRole = (currentUser && currentUser.role ? currentUser.role.toLowerCase() : '');
  const isAdmin = userRole === 'admin' || userRole === 'system admin';
  const isTrainManager = userRole === 'train_manager';
  const isStationMaster = userRole === 'station_master';

  const tableBody = document.getElementById('scheduleRequestsTableBody');
  const modalOverlay = document.getElementById('scheduleRequestModalOverlay');
  const modalForm = document.getElementById('scheduleRequestModalForm');
  const trainSelect = document.getElementById('reqModalTrainSelect');
  const currentInfoBox = document.getElementById('reqModalCurrentInfo');
  const currentInfoVal = document.getElementById('reqModalCurrentInfoVal');
  const newReqBtn = document.getElementById('openNewRequestBtn');

  let scheduleRows = [];
  let requestRows = [];

  if (isStationMaster && newReqBtn) {
    newReqBtn.style.display = 'none';
  }

  if (newReqBtn && !newReqBtn.dataset.bound) {
    newReqBtn.dataset.bound = 'true';
    newReqBtn.addEventListener('click', function () {
      window.openScheduleRequestModal();
    });
  }

  function escapeHtml(value) {
    return String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function normalizeRequest(row) {
    const statusRaw = String(
      row.status ||
      row.STATUS ||
      'PENDING'
    ).toUpperCase();

    let status = 'Pending';
    if (statusRaw === 'APPROVED') status = 'Approved';
    if (statusRaw === 'REJECTED') status = 'Rejected';

    const trainId =
      row.train_id ||
      row.TRAIN_ID ||
      row.trainId ||
      '';

    const trainName =
      row.train_name ||
      row.TRAIN_NAME ||
      row.train ||
      trainId;

    const requestId =
      row.request_id ||
      row.REQUEST_ID ||
      row.id ||
      'N/A';

    const requestedChange =
      row.requested_change ||
      row.REQUESTED_CHANGE ||
      row.requestedChange ||
      '';

    const reason =
      row.reason ||
      row.REASON ||
      '';

    const requestedBy =
      row.requested_by ||
      row.REQUESTED_BY ||
      row.requestedBy ||
      'Unknown';

    const requestDate =
      row.request_date ||
      row.REQUEST_DATE ||
      row.createdAt ||
      '';

    return {
      id: requestId,
      trainId: trainId,
      train: trainName,
      scheduleId:
        row.schedule_id ||
        row.SCHEDULE_ID ||
        '',
      currentSchedule: buildScheduleSummary(
        scheduleRows.find(s =>
          s.id === (row.schedule_id || row.SCHEDULE_ID)
        )
      ),
      requestedChange: requestedChange,
      reason: reason,
      status: status,
      requestedBy: requestedBy,
      createdAt: requestDate
    };
  }

  function buildScheduleSummary(sched) {
    if (!sched) {
      return 'Current timetable unavailable';
    }

    return `Dept: ${sched.departureTime || 'N/A'} | Arr: ${sched.arrivalTime || 'N/A'} | Route: ${sched.source || 'N/A'} ? ${sched.destination || 'N/A'} | Platform: ${sched.platform || 'N/A'} | Status: ${sched.status || 'N/A'}`;
  }

  async function loadSchedules() {
    try {
      const result = await databaseGet('manage-schedules.html');

      if (Array.isArray(result)) {
        scheduleRows = result;
      } else if (Array.isArray(result?.schedules)) {
        scheduleRows = result.schedules;
      } else if (Array.isArray(result?.data)) {
        scheduleRows = result.data;
      } else {
        scheduleRows = [];
      }

      console.log(
        '[SCHEDULE REQUESTS] Loaded schedules:',
        scheduleRows
      );
    } catch (err) {
      console.warn(
        '[SCHEDULE REQUESTS] Could not load schedules:',
        err
      );
      scheduleRows = [];
    }

    populateModalTrains();
  }

  async function loadRequests() {
    try {
      const result = await apiCall('GET', '/api/manager/schedule-requests');

      if (!result.ok) {
        throw new Error(result.error || 'Failed to load schedule requests.');
      }

      const rows =
        result.data?.requests ||
        result.data?.data ||
        result.data ||
        [];

      requestRows = Array.isArray(rows)
        ? rows.map(normalizeRequest)
        : [];

      renderRequestsTable();
    } catch (err) {
      console.warn('[SCHEDULE REQUESTS] Could not load requests:', err);

      requestRows = [];

      if (tableBody) {
        tableBody.innerHTML =
          `<tr><td colspan="8" class="text-center text-rose-300 py-6">Unable to load schedule requests from database.</td></tr>`;
      }
    }
  }

  function populateModalTrains() {
    if (!trainSelect) return;

    if (!Array.isArray(scheduleRows) || scheduleRows.length === 0) {
      trainSelect.innerHTML =
        '<option value="">No schedules available</option>';

      updateCurrentScheduleDisplay();
      return;
    }

    trainSelect.innerHTML = scheduleRows.map(s => {
      const scheduleId =
        s.id ||
        s.schedule_id ||
        s.SCHEDULE_ID ||
        '';

      const trainId =
        s.trainId ||
        s.train_id ||
        s.TRAIN_ID ||
        '';

      const trainName =
        s.trainName ||
        s.train_name ||
        s.TRAIN_NAME ||
        trainId;

      return `<option value="${escapeHtml(scheduleId)}">${escapeHtml(trainName)} (${escapeHtml(trainId)})</option>`;
    }).join('');

    updateCurrentScheduleDisplay();
  }

  function getSelectedSchedule() {
    if (!trainSelect) return null;

    const selectedScheduleId = trainSelect.value;

    return scheduleRows.find(s =>
      String(
        s.id ||
        s.schedule_id ||
        s.SCHEDULE_ID ||
        ''
      ) === String(selectedScheduleId)
    ) || null;
  }

  function updateCurrentScheduleDisplay() {
    if (!trainSelect || !currentInfoBox) return;

    const sched = getSelectedSchedule();

    if (sched) {
      const summary = buildScheduleSummary(sched);

      currentInfoBox.innerHTML = `
        <div class="space-y-1">
          <div class="text-white font-bold">${escapeHtml(sched.trainName)} (${escapeHtml(sched.trainId)})</div>
          <div class="text-slate-300">
            Timetable:
            <span class="text-cyan-300 font-bold">
              ${escapeHtml(sched.departureTime)} ? ${escapeHtml(sched.arrivalTime)}
            </span>
          </div>
          <div class="text-slate-300">
            Route:
            <span class="text-white">
              ${escapeHtml(sched.source)} ? ${escapeHtml(sched.destination)}
            </span>
          </div>
          <div class="text-slate-300">
            Platform:
            <span class="text-amber-300">${escapeHtml(sched.platform || 'N/A')}</span>
            (${escapeHtml(sched.status || 'Operational')})
          </div>
        </div>
      `;

      if (currentInfoVal) {
        currentInfoVal.value = summary;
      }
    } else {
      currentInfoBox.innerHTML =
        `<span class="text-slate-400">Timetable details will sync automatically</span>`;

      if (currentInfoVal) {
        currentInfoVal.value = 'Current timetable unavailable';
      }
    }
  }

  if (trainSelect && !trainSelect.dataset.boundDb) {
    trainSelect.dataset.boundDb = 'true';
    trainSelect.addEventListener('change', updateCurrentScheduleDisplay);
  }

  window.openScheduleRequestModal = async function(scheduleId) {
    await loadSchedules();

    if (scheduleId && trainSelect) {
      const found = scheduleRows.find(s =>
        s.id === scheduleId ||
        s.trainId === scheduleId
      );

      if (found) {
        trainSelect.value = found.trainId || found.id;
        updateCurrentScheduleDisplay();
      }
    }

    if (modalOverlay) {
      modalOverlay.classList.add('active');
    }
  };

  if (modalForm && !modalForm.dataset.boundDb) {
    modalForm.dataset.boundDb = 'true';

    modalForm.addEventListener('submit', async function(e) {
      e.preventDefault();

      const selected = getSelectedSchedule();

      if (!selected) {
        showToast('Please select a train schedule.', 'danger');
        return;
      }

      const requestedChange =
        document.getElementById('reqModalRequestedChange')?.value.trim() || '';

      const reason =
        document.getElementById('reqModalReason')?.value.trim() || '';

      if (!requestedChange) {
        showToast('Please describe the requested schedule change.', 'danger');
        return;
      }

      const result = await apiCall(
        'POST',
        '/api/manager/schedule-requests',
        {
          train_id: selected.trainId,
          schedule_id: selected.id,
          requested_change: requestedChange,
          reason: reason
        }
      );

      if (!result.ok) {
        showToast(
          result.error || 'Failed to submit schedule request.',
          'danger'
        );
        return;
      }

      const requestId =
        result.data?.request_id ||
        result.data?.REQUEST_ID ||
        'new request';

      if (modalOverlay) modalOverlay.classList.remove('active');
      modalForm.reset();

      await loadRequests();

      showToast(
        `Schedule update request ${requestId} submitted for Admin review (Status: Pending)!`,
        'success'
      );
    });
  }

  function renderRequestsTable() {
    if (!tableBody) return;

    if (requestRows.length === 0) {
      tableBody.innerHTML =
        `<tr><td colspan="8" class="text-center text-slate-400 py-6">No schedule update requests logged yet.</td></tr>`;
      return;
    }

    tableBody.innerHTML = requestRows.map(r => {
      let statusBadge = '';

      if (r.status === 'Approved') {
        statusBadge =
          `<span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">✓ Approved</span>`;
      } else if (r.status === 'Rejected') {
        statusBadge =
          `<span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-rose-500/20 text-rose-300 border border-rose-500/30">✕ Rejected</span>`;
      } else {
        statusBadge =
          `<span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30">⏳ Pending</span>`;
      }

      let actionsHtml = '';

      if (isAdmin && r.status === 'Pending') {
        actionsHtml = `
          <div class="flex gap-1 flex-nowrap min-w-max">
            <button onclick="approveScheduleRequest('${escapeHtml(r.id)}')" class="px-2.5 py-1 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg font-bold text-xs cursor-pointer shadow transition-all">✓ Approve</button>
            <button onclick="rejectScheduleRequest('${escapeHtml(r.id)}')" class="px-2.5 py-1 bg-rose-600 hover:bg-rose-500 text-white rounded-lg font-bold text-xs cursor-pointer shadow transition-all whitespace-nowrap flex-shrink-0">✕ Reject</button>
          </div>
        `;
      } else if (isAdmin) {
        actionsHtml =
          `<span class="text-xs text-slate-400 font-semibold italic">Processed</span>`;
      } else {
        actionsHtml =
          `<span class="text-xs text-slate-400 font-semibold">${escapeHtml(r.status)}</span>`;
      }

      return `
        <tr>
          <td><strong class="font-mono text-cyan-300">${escapeHtml(r.id)}</strong></td>
          <td><strong class="text-white">${escapeHtml(r.train)}</strong></td>
          <td class="text-xs text-slate-300 max-w-[200px] truncate" title="${escapeHtml(r.currentSchedule)}">${escapeHtml(r.currentSchedule)}</td>
          <td class="text-xs text-white max-w-[220px]">${escapeHtml(r.requestedChange)}</td>
          <td class="text-xs text-slate-400 max-w-[180px]">${escapeHtml(r.reason)}</td>
          <td>${statusBadge}</td>
          <td class="text-xs text-slate-300">${escapeHtml(r.requestedBy)}<br><span class="text-[10px] text-slate-500">${escapeHtml(r.createdAt)}</span></td>
          <td>${actionsHtml}</td>
        </tr>
      `;
    }).join('');
  }

  window.approveScheduleRequest = async function(reqId) {
    const result = await apiCall(
      'PUT',
      `/api/admin/schedule-requests/${encodeURIComponent(reqId)}/approve`
    );

    if (!result.ok) {
      showToast(
        result.error || `Failed to approve request ${reqId}.`,
        'danger'
      );
      return;
    }

    await loadRequests();
    await loadSchedules();

    showToast(
      `Schedule update request ${reqId} Approved. Timetable synchronized!`,
      'success'
    );

    if (typeof window.refreshDatabasePage === 'function') {
      window.refreshDatabasePage('manage-schedules.html');
    }
  };

  window.rejectScheduleRequest = async function(reqId) {
    const result = await apiCall(
      'PUT',
      `/api/admin/schedule-requests/${encodeURIComponent(reqId)}/reject`
    );

    if (!result.ok) {
      showToast(
        result.error || `Failed to reject request ${reqId}.`,
        'danger'
      );
      return;
    }

    await loadRequests();

    showToast(
      `Schedule update request ${reqId} marked as Rejected.`,
      'info'
    );
  };

  loadSchedules();
  loadRequests();
}
