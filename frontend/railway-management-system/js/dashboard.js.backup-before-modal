            <button
              onclick="window.openLostDetailModal('${item.id}')"
              class="px-3 py-1.5 text-xs font-bold rounded-lg bg-sky-50 text-sky-700 hover:bg-sky-100 border border-sky-200 transition-all flex items-center gap-1">
              <span>🔎</span> Details
            </button>
          </div>
        </div>

      </div>
    `;
  }).join('');
}
