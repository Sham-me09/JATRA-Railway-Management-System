}

/* ==========================================================================
   2. MY TICKETS PAGE
   ========================================================================== */
async function renderMyTicketsPage() {
  const currentUser = getCurrentUser() || { id: 'USR-1001', phone: '01711223344' };
  const container = document.getElementById('myTicketsContainer');
  if (!container) return;

  // -- Load delay alerts from API --------------------------------------------
  let delayMap = {};  // ticketId ? delay info
  const delayResult = await apiCall('GET', '/api/notifications/delays');
  if (delayResult.ok && delayResult.data && Array.isArray(delayResult.data.delays)) {
    delayResult.data.delays.forEach(d => {
      if (d.ticketId) delayMap[d.ticketId] = d;
    });
  }

  // Render Real-Time Passenger Delay Notifications
  renderPassengerDelayAlertBanner('passengerDelayAlertContainer');

  // -- Load my bookings from API ---------------------------------------------
  let myTickets = [];
  const bookingResult = await apiCall('GET', '/api/bookings');
  if (bookingResult.ok && bookingResult.data && Array.isArray(bookingResult.data.bookings)) {
    myTickets = bookingResult.data.bookings;
    // Merge into localStorage tickets cache so other pages still work
    const localTickets = JSON.parse(localStorage.getItem('tickets') || '[]');
    myTickets.forEach(apiTicket => {
      const idx = localTickets.findIndex(t => t.id === apiTicket.id || t.ticketId === apiTicket.ticketId);
      const merged = {
        id: apiTicket.id,
        ticketId: apiTicket.ticketId,
        trainId: apiTicket.trainId,
        trainName: apiTicket.trainName,
        source: apiTicket.source,
        destination: apiTicket.destination,
        deptTime: apiTicket.deptTime,
        arrTime: apiTicket.arrTime,
        coach: apiTicket.coach,
        seats: apiTicket.seatNumber ? [apiTicket.seatNumber] : [],
        journeyDate: apiTicket.journeyDate,
        bookingStatus: apiTicket.bookingStatus,
        grandTotal: apiTicket.grandTotal,
        paymentMethod: apiTicket.paymentMethod,
        userId: currentUser.id,
        delay: apiTicket.delay,
      };
      if (idx >= 0) localTickets[idx] = merged;
      else localTickets.unshift(merged);
    });
    localStorage.setItem('tickets', JSON.stringify(localTickets));
  } else {
    // -- Fallback: localStorage ------------------------------------------------
    console.warn('[DASHBOARD] API unavailable, using localStorage for my tickets.');
    const tickets = JSON.parse(localStorage.getItem('tickets') || '[]');
    myTickets = tickets.filter(t =>
      t.userId === currentUser.id || t.passengerPhone === currentUser.phone || t.userId === 'USR-1001'
    );
  }

  if (myTickets.length === 0) {
    container.innerHTML = `
      <div class="card text-center" style="padding: 3rem;">
        <h3>No Tickets Found</h3>
        <p>You have not booked any train tickets yet.</p>
        <a href="search-train.html" class="btn btn-primary" style="margin-top: 1rem;">Book Train Ticket</a>
      </div>
    `;
    return;
  }

  const allTrains = JSON.parse(localStorage.getItem('trains') || '[]');

  container.innerHTML = myTickets.map(t => {
    const matchedTrain = allTrains.find(tr => tr.id === t.trainId || tr.name === t.trainName);
    // Check delay from API response first, then localStorage train, then ticket
    const apiDelay = delayMap[t.ticketId] || delayMap[t.id];
    const delayMins = apiDelay
      ? parseInt((apiDelay.delay || '0').replace(/\D/g, '')) || 0
      : ((matchedTrain ? matchedTrain.delayMinutes : t.delayMinutes) || t.delayMinutes || 0);
    const delayReason = apiDelay
      ? (apiDelay.delayReason || 'Operational delay')
      : ((matchedTrain ? matchedTrain.delayReason : t.delayReason) || t.delayReason || 'Operational traffic / signaling buffer');
    const isDelayed = delayMins > 0;

    return `
      <div class="card" style="margin-bottom: 1.25rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-color); padding-bottom: 0.75rem; margin-bottom: 1rem; flex-wrap: wrap; gap: 0.5rem;">
          <div>
            <span class="badge badge-navy">${t.ticketId || t.id}</span>
            <strong style="font-size: 1.1rem; color: var(--primary-navy); margin-left: 0.5rem;">${t.trainName}</strong>
          </div>
          <div style="display: flex; gap: 0.5rem; align-items: center;">
            ${isDelayed ? `<span class="badge badge-warning" style="font-weight: 800;">?  +${delayMins}m Delayed</span>` : ''}
            <span class="badge ${t.bookingStatus === 'Confirmed' || t.bookingStatus === 'CONFIRMED' ? 'badge-success' : 'badge-danger'}">${t.bookingStatus}</span>
          </div>
        </div>

        ${isDelayed ? `
          <div style="background: #fffbeb; border: 1px solid #fcd34d; border-radius: 8px; padding: 0.75rem 1rem; margin-bottom: 1rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.25rem;">
              <strong style="color: #b45309; font-size: 0.85rem; display: flex; align-items: center; gap: 0.4rem;">
                <span>? </span> PASSENGER TRAIN DELAY ALERT
              </strong>
              <span style="background: #d97706; color: #fff; font-size: 0.75rem; font-weight: 700; padding: 0.15rem 0.5rem; border-radius: 4px;">+${delayMins} Min Delay</span>
            </div>
            <p style="margin: 0; font-size: 0.8rem; color: #92400e;">
              <strong>Cause:</strong> ${delayReason}
            </p>
            <p style="margin: 0.25rem 0 0 0; font-size: 0.8rem; color: #78350f;">
              <strong>Scheduled Departure:</strong> ${t.deptTime || t.departureTime || matchedTrain?.departure || '07:00 AM'} &nbsp;|&nbsp; <strong>Revised Estimated Departure:</strong> <span style="font-weight: 800; color: #065f46;">${calculateRevisedTime(t.deptTime || t.departureTime || matchedTrain?.departure || '07:00 AM', delayMins)}</span>
            </p>
          </div>
        ` : ''}

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; margin-bottom: 1rem;">
          <div>
            <div style="font-size: 0.8rem; color: var(--text-muted);">Route</div>
            <div style="font-weight: 600;">${t.source} ? ${t.destination}</div>
          </div>
          <div>
            <div style="font-size: 0.8rem; color: var(--text-muted);">Coach & Seats</div>
            <div style="font-weight: 600; color: var(--accent-blue);">${t.coach || 'N/A'} | ${Array.isArray(t.seats) ? t.seats.join(', ') : (t.seatNumber || 'N/A')}</div>
          </div>
          <div>
            <div style="font-size: 0.8rem; color: var(--text-muted);">Journey Date</div>
            <div style="font-weight: 600;">${t.journeyDate || 'Today'}</div>
          </div>
          <div>
            <div style="font-size: 0.8rem; color: var(--text-muted);">Total Paid</div>
            <div style="font-weight: 700; color: var(--primary-navy);">${formatBDT(t.grandTotal)}</div>
          </div>
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 0.75rem; border-top: 1px solid var(--border-color); padding-top: 0.75rem;">
          <button onclick="viewTicketModal('${t.id}')" class="btn btn-outline btn-sm">View Ticket Voucher</button>
          ${(t.bookingStatus === 'Confirmed' || t.bookingStatus === 'CONFIRMED')
            ? `<button onclick="initiateCancellation('${t.ticketId || t.id}')" class="btn btn-danger btn-sm">Cancel Ticket</button>`
            : `<span style="font-size: 0.85rem; color: var(--text-muted); align-self: center;">Ticket Cancelled</span>`
          }
        </div>
      </div>
    `;
  }).join('');
}


function viewTicketModal(ticketId) {
  const tickets = JSON.parse(localStorage.getItem('tickets') || '[]');
  const t = tickets.find(item => item.id === ticketId || item.ticketId === ticketId);
  if (!t) return;

  localStorage.setItem('lastConfirmedTicket', JSON.stringify(t));
  window.location.href = 'booking-confirmation.html';
}

function initiateCancellation(ticketId) {
  localStorage.setItem('cancellingTicketId', ticketId);
  window.location.href = 'cancellation.html';
}

function downloadTicket(ticketId) {
  const tickets = JSON.parse(localStorage.getItem('tickets') || '[]');
  const t = tickets.find(item => item.id === ticketId || item.ticketId === ticketId);
  if (t) {
    localStorage.setItem('lastConfirmedTicket', JSON.stringify(t));
    window.location.href = 'booking-confirmation.html';
  } else {
    window.print();
  }
}

function startBooking(trainId) {
  localStorage.setItem('selectedTrainId', trainId);
  window.location.href = 'seat-selection.html';
}

window.viewTicketModal = viewTicketModal;
window.initiateCancellation = initiateCancellation;
window.downloadTicket = downloadTicket;
window.startBooking = startBooking;

/* ==========================================================================
   3. CANCELLATION, REFUND, COMPLAINT & LOST ITEM FORMS
   ========================================================================== */
function renderCancellationPage() {
  const form = document.getElementById('cancellationForm');
  const targetId = localStorage.getItem('cancellingTicketId');
  if (targetId && document.getElementById('cancelTicketId')) {
    document.getElementById('cancelTicketId').value = targetId;
  }

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const ticketId = document.getElementById('cancelTicketId').value.trim();
      const reason = document.getElementById('cancelReason').value.trim();

      if (!ticketId || !reason) {
        showToast('Please specify Ticket ID and reason.', 'danger');
        return;
      }

      const submitBtn = form.querySelector('button[type="submit"]');
      if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Processing Cancellation...'; }

      // -- Call real API ------------------------------------------------------
      const res = await apiCall('POST', `/api/tickets/${encodeURIComponent(ticketId)}/cancel`, { reason });

      if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Confirm Cancellation'; }

      if (res.ok && res.data) {
        const { cancellation_id, refund_amount } = res.data;

        // Update local state
        const tickets = JSON.parse(localStorage.getItem('tickets') || '[]');
        const ticket = tickets.find(t => t.ticketId === ticketId || t.id === ticketId);
        if (ticket) {
          ticket.bookingStatus = 'Cancelled';
          localStorage.setItem('tickets', JSON.stringify(tickets));
        }

        const cancellations = JSON.parse(localStorage.getItem('cancellations') || '[]');
        cancellations.unshift({
          id: cancellation_id,
          ticketId: ticketId,
          reason: reason,
          refundAmount: refund_amount,
          status: 'Approved',
          requestedAt: new Date().toISOString().split('T')[0]
        });
        localStorage.setItem('cancellations', JSON.stringify(cancellations));

        const refunds = JSON.parse(localStorage.getItem('refunds') || '[]');
        refunds.unshift({
          id: `RFD-${Math.floor(200 + Math.random() * 800)}`,
          cancellationId: cancellation_id,
          amount: refund_amount,
          status: 'Completed',
          processedAt: new Date().toISOString().split('T')[0]
        });
        localStorage.setItem('refunds', JSON.stringify(refunds));

        showToast(`Cancellation confirmed! Refund of ${formatBDT(refund_amount)} approved.`, 'success');
        setTimeout(() => { window.location.href = 'refund.html'; }, 900);
        return;
      }

      if (res.status === 404 || res.status === 409 || res.status === 403) {
        showToast(res.error || 'Cancellation could not be processed.', 'danger');
        return;
      }

      // Offline fallback
      const tickets = JSON.parse(localStorage.getItem('tickets') || '[]');
      const ticket = tickets.find(t => t.ticketId === ticketId || t.id === ticketId);
      if (!ticket) {
        showToast('Ticket ID not found in system records.', 'danger');
        return;
      }
      ticket.bookingStatus = 'Cancelled';
      localStorage.setItem('tickets', JSON.stringify(tickets));
      const cncId = `CNC-${Math.floor(100 + Math.random() * 900)}`;
      const refundAmt = Math.round((ticket.grandTotal || 650) * 0.85);
      const cancellations = JSON.parse(localStorage.getItem('cancellations') || '[]');
      cancellations.unshift({
        id: cncId, ticketId, reason, refundAmount: refundAmt, status: 'Approved',
        requestedAt: new Date().toISOString().split('T')[0]
      });
      localStorage.setItem('cancellations', JSON.stringify(cancellations));
      const refunds = JSON.parse(localStorage.getItem('refunds') || '[]');
      refunds.unshift({
        id: `RFD-${Math.floor(200 + Math.random() * 800)}`, cancellationId: cncId, amount: refundAmt,
        status: 'Completed', processedAt: new Date().toISOString().split('T')[0]
      });
      localStorage.setItem('refunds', JSON.stringify(refunds));
      showToast(`Cancellation submitted! Refund of ${formatBDT(refundAmt)} approved. [Offline mode]`, 'success');
      setTimeout(() => { window.location.href = 'refund.html'; }, 900);
    });
  }
}

