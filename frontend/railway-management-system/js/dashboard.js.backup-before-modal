    }

    ticketsContainer.innerHTML = `
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>Ticket ID</th>
              <th>Train Name</th>
              <th>From</th>
              <th>To</th>
              <th>Journey Date</th>
              <th>Coach & Seats</th>
              <th>Status</th>
              <th class="text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            ${userTickets.map(t => {
              const seatDisplay = Array.isArray(t.seats) ? t.seats.join(', ') : (t.seats || 'N/A');
              const ticketId = t.ticketId || t.id;
              const isConfirmed = (t.bookingStatus === 'Confirmed');

              const allTrains = JSON.parse(localStorage.getItem('trains') || '[]');
              const matchedTrain = allTrains.find(tr => tr.id === t.trainId || tr.name === t.trainName);
              const delayMins = (matchedTrain ? matchedTrain.delayMinutes : t.delayMinutes) || t.delayMinutes || 0;
              const isDelayed = delayMins > 0;

              return `
                <tr>
                  <td><strong class="font-mono text-xs text-slate-800">${ticketId}</strong></td>
