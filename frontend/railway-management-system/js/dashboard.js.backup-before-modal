/* ==========================================================================
   5. GENERIC ADMIN DATATABLE CRUD ENGINE FOR ALL 15 MANAGEMENT PAGES
   ========================================================================== */
async function initAdminCrudTable(pagePath) {
  const currentUser = getCurrentUser() || {};

  // Map page path to storage key & schema definition
  const config = {
    'manage-trains.html': {
key: 'trains',
title: 'Train',
fields: ['name', 'type', 'travelDuration', 'offDay', 'status']
},

    'manage-coaches.html': {
  key: 'coaches',
  title: 'Coach',
  fields: ['trainId', 'name', 'type', 'seatsCount', 'status']
},
    'manage-seats.html': { key: 'seats', title: 'Seat', fields: ['trainId', 'coach', 'seatNumber', 'classType', 'status'] },
    'manage-stations.html': { key: 'stations', title: 'Station', fields: ['name', 'code', 'city', 'platforms', 'status'] },
    'manage-platforms.html': { key: 'platforms', title: 'Platform', fields: ['station', 'platformNumber', 'type', 'status'] },
    'manage-routes.html': { key: 'routes', title: 'Route', fields: ['routeName', 'source', 'destination', 'distanceKm', 'status'] },
    'manage-schedules.html': { key: 'schedules', title: 'Train Schedule', fields: ['trainName', 'trainId', 'departureTime', 'arrivalTime', 'source', 'destination', 'platform', 'status'] },
    'manage-bookings.html': { key: 'bookings', title: 'Booking', fields: ['passengerName', 'trainName', 'coach', 'grandTotal', 'bookingStatus'] },
    'manage-payments.html': { key: 'bookings', title: 'Payment', fields: ['id', 'passengerName', 'grandTotal', 'paymentMethod', 'paymentStatus'] },
    'manage-tickets.html': { key: 'tickets', title: 'Ticket', fields: ['ticketId', 'passengerName', 'trainName', 'coach', 'bookingStatus'] },
    'manage-cancellations.html': { key: 'cancellations', title: 'Cancellation', fields: ['ticketId', 'train', 'reason', 'refundAmount', 'status'] },
    'manage-refunds.html': { key: 'refunds', title: 'Refund', fields: ['cancellationId', 'amount', 'status', 'processedAt'] },
    'manage-complaints.html': { key: 'complaints', title: 'Complaint', fields: ['name', 'train', 'description', 'status'] },
    'manage-lost-items.html': { key: 'lostItems', title: 'Lost Item', fields: ['item', 'train', 'date', 'description', 'status'] },
    'manage-maintenance.html': { key: 'maintenanceLogs', title: 'Maintenance Work Order', fields: ['trainName', 'category', 'target', 'severity', 'status', 'date'] },
    'manage-employees.html': { key: 'employees', title: 'Employee', fields: ['name', 'designation', 'station', 'phone', 'emergencyContact', 'status'] }
  }[pagePath];

  if (!config) return;

  let currentData = JSON.parse(localStorage.getItem(config.key) || '[]');

  // Database-managed pages must always come from Oracle, not localStorage.
  const databaseManagedPages = [
    'manage-trains.html',
    'manage-coaches.html',
    'manage-seats.html',
    'manage-stations.html',
    'manage-platforms.html',
    'manage-routes.html',
    'manage-fares.html',
    'manage-employees.html',
    'manage-maintenance.html',
    'manage-schedules.html',
    'manage-complaints.html'
  ];

  if (databaseManagedPages.includes(pagePath) && typeof databaseGet === 'function') {
    try {
      currentData = await databaseGet(pagePath);
      console.log('[DATABASE CRUD] Loaded from Oracle:', pagePath, currentData);
    } catch (error) {
      console.error('[DATABASE CRUD] Failed to load from Oracle:', pagePath, error);
      currentData = [];
    }
  }

  // Station-wise Isolation for Station Master, Ticket Manager, and Train Manager
  const userRole = currentUser.role;
  const userStation = currentUser.station || '';
  let isStationScoped = false;

  if (['station_master', 'ticket_manager', 'train_manager'].includes(userRole) && userStation) {
    isStationScoped = true;

    if (pagePath === 'manage-stations.html') {
      currentData = currentData.filter(s => s.name === userStation || (s.city && userStation.includes(s.city)));
    } else if (pagePath === 'manage-platforms.html') {
      currentData = currentData.filter(p => p.station === userStation || (p.station && p.station.includes(userStation.split(' ')[0])));
    } else if (pagePath === 'manage-trains.html') {
      // Train master records do not contain source/destination station fields.
      // Do not incorrectly hide all trains for Train Manager station scope.
      currentData = currentData;
    } else if (pagePath === 'manage-schedules.html') {
      currentData = currentData.filter(sch => sch.source === userStation || sch.destination === userStation || (sch.source && sch.source.includes(userStation.split(' ')[0])) || (sch.destination && sch.destination.includes(userStation.split(' ')[0])) || (sch.routeInfo && sch.routeInfo.includes(userStation.split(' ')[0])));
    } else if (pagePath === 'manage-tickets.html' || pagePath === 'manage-bookings.html') {
      // Train master records do not contain source/destination station fields.
      // Do not incorrectly hide all trains for Train Manager station scope.
      currentData = currentData;
    } else if (pagePath === 'manage-cancellations.html') {
      currentData = currentData.filter(c => !c.station || c.station === userStation || (currentUser.assignedTrainName && c.train === currentUser.assignedTrainName));
    } else if (pagePath === 'manage-lost-items.html') {
