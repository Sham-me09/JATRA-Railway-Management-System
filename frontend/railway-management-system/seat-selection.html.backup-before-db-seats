      <button class="mobile-nav-toggle" id="mobileNavToggle" aria-label="Toggle Navigation">â˜°</button>

      <ul class="nav-menu" id="navMenu">
        <li><a href="index.html" class="nav-link">Home</a></li>
        <li><a href="search-train.html" class="nav-link active">Search Trains</a></li>
        <li><a href="my-tickets.html" class="nav-link">My Tickets</a></li>
        <li><a href="complaint.html" class="nav-link">Complaints</a></li>
      </ul>

      <div class="nav-actions" id="navActions"></div>
    </div>
  </nav>

  <div class="container" style="padding: 2.5rem 1.5rem; min-height: 80vh;">
    <div id="selectedTrainHeader" class="card" style="margin-bottom: 2rem;"></div>

    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 2rem;" class="form-row">
      
      <!-- Seat Selection Grid Column -->
      <div class="card">
        <h3>Select Coach Class & Seat Layout</h3>
        <p style="font-size: 0.9rem;">Click on any available seat to add it to your booking cart (max 4 seats).</p>

        <!-- Coach Selector Tabs -->
        <div id="coachSelectorContainer" style="display: flex; gap: 0.5rem; margin-bottom: 1.5rem; flex-wrap: wrap;">
  <!-- Coach buttons are loaded from the database by booking.js -->
</div>

        <!-- Legend -->
        <div class="seat-legend">
          <div class="legend-item"><div class="legend-box" style="background: #ffffff; border: 1px solid var(--accent-blue);"></div> Available</div>
          <div class="legend-item"><div class="legend-box" style="background: var(--accent-blue);"></div> Selected</div>
          <div class="legend-item"><div class="legend-box" style="background: var(--border-color);"></div> Booked</div>
        </div>

        <!-- Interactive Seat Grid -->
        <div class="seat-grid-wrapper" id="seatGridContainer">
          <!-- Injected by booking.js -->
        </div>
      </div>

      <!-- Booking Summary Sidebar -->
      <div class="card" style="height: fit-content;">
        <h3 style="border-bottom: 1px solid var(--border-color); padding-bottom: 0.75rem;">Booking Summary</h3>
        
        <div style="margin: 1.25rem 0; font-size: 0.95rem; line-height: 2;">
          <div style="display: flex; justify-content: space-between;">
            <span style="color: var(--text-muted);">Seats Selected:</span>
            <strong id="summarySeatCount">0</strong>
          </div>
          <div style="display: flex; justify-content: space-between;">
            <span style="color: var(--text-muted);">Selected Seat IDs:</span>
            <strong id="summarySeatList" style="color: var(--accent-blue);">None</strong>
          </div>
          <div style="display: flex; justify-content: space-between;">
            <span style="color: var(--text-muted);">Base Fare Subtotal:</span>
            <strong id="summaryTotalFare">Ã Â§Â³0</strong>
          </div>
          <div style="display: flex; justify-content: space-between;">
            <span style="color: var(--text-muted);">VAT (5%):</span>
            <strong id="summaryVat">Ã Â§Â³0</strong>
          </div>
          <div style="display: flex; justify-content: space-between;">
            <span style="color: var(--text-muted);">Service Charge:</span>
            <strong>Ã Â§Â³20</strong>
          </div>
          <div style="display: flex; justify-content: space-between; font-size: 1.25rem; font-weight: 800; color: var(--primary-navy); border-top: 1px solid var(--border-color); padding-top: 0.75rem; margin-top: 0.5rem;">
            <span>Grand Total:</span>
            <span id="summaryGrandTotal" style="color: var(--accent-blue);">Ã Â§Â³20</span>
          </div>
        </div>

        <button id="proceedToPassengerBtn" class="btn btn-primary btn-lg btn-full">
          Continue to Passenger Details â†’
        </button>
      </div>

    </div>
  </div>

  <footer class="footer">
    <div class="container text-center">
      <p>&copy; 2026 Bangladesh JATRA: RAILWAY MANAGEMENT SYSTEM.</p>
    </div>
  </footer>

  <script src="js/main.js"></script>
  <script src="js/booking.js"></script>
